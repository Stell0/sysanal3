# Inspect a bounded tail in one pass; print pattern names, never log records.
# Print each pattern (one per line in $1) that matches stdin, case-insensitively.
match_log_patterns() {
    SYSANAL_LOG_PATTERNS="$1" awk '
        BEGIN {
            count=split(ENVIRON["SYSANAL_LOG_PATTERNS"], patterns, "\n")
            for (i=1; i<=count; i++) folded[i]=tolower(patterns[i])
        }
        {
            line=tolower($0)
            for (i=1; i<=count; i++)
                if (patterns[i] != "" && !matched[i] && line ~ folded[i]) matched[i]=1
        }
        END {
            for (i=1; i<=count; i++) if (matched[i]) print patterns[i]
        }'
}

scan_recent_log_patterns() {
    local log_file="$1" patterns="$2" status
    local -a scan_status=()
    [[ "$LOG_SCAN_MAX_BYTES" =~ ^[1-9][0-9]*$ && "$LOG_SCAN_MAX_LINES" =~ ^[1-9][0-9]*$ ]] || return 2
    tail -c "$LOG_SCAN_MAX_BYTES" -- "$log_file" 2>/dev/null |
        tail -n "$LOG_SCAN_MAX_LINES" |
        match_log_patterns "$patterns"
    scan_status=("${PIPESTATUS[@]}")
    for status in "${scan_status[@]}"; do
        [[ "$status" == 0 ]] || return 2
    done
    return 0
}

check_nethvoice_asterisk_full_logs() {
    local nv_mod="$1" log_scan_out pattern
    # Send our fixed helper source as stdin; environment values remain arguments.
    # FreePBX has Bash; unavailable runtimes are reported as skipped checks.
    # shellcheck disable=SC2016
    if ! log_scan_out=$({
        declare -f match_log_patterns scan_recent_log_patterns
        printf '%s\n' 'LOG_SCAN_MAX_BYTES="$3"; LOG_SCAN_MAX_LINES="$4"; scan_recent_log_patterns "$1" "$2"'
    } | timeout 15s runagent -m "$nv_mod" podman exec -i freepbx bash -s -- \
        /var/log/asterisk/full "$ASTERISK_FULL_LOG_ERROR_PATTERNS" \
        "$LOG_SCAN_MAX_BYTES" "$LOG_SCAN_MAX_LINES" 2>/dev/null); then
        warning "${nv_mod}: could not scan the recent Asterisk full log (check file readability and container runtime)"
        return 0
    fi
    while IFS= read -r pattern; do
        [[ -z "$pattern" ]] && continue
        problem "${nv_mod}: recent Asterisk full log contains common error pattern: ${pattern}"
    done <<< "$log_scan_out"
    [[ -z "$log_scan_out" ]] && ok "${nv_mod}: No common error found in the recent Asterisk full log"
    return 0
}

check_system_messages_log() {
    local log_file="${1:-/var/log/messages}" log_scan_out pattern
    if [[ ! -f "$log_file" || ! -r "$log_file" ]]; then
        warning "${log_file} is missing or unreadable"
        return 0
    fi
    # The child owns its arguments and receives only our reviewed helper source.
    # shellcheck disable=SC2016
    if ! log_scan_out=$(timeout 15s bash -c \
        'LOG_SCAN_MAX_BYTES="$3"; LOG_SCAN_MAX_LINES="$4"; source /dev/stdin; scan_recent_log_patterns "$1" "$2"' \
        bash "$log_file" "$MESSAGES_LOG_ERROR_PATTERNS" "$LOG_SCAN_MAX_BYTES" "$LOG_SCAN_MAX_LINES" \
        < <(declare -f match_log_patterns scan_recent_log_patterns) 2>/dev/null); then
        warning "Could not scan the recent ${log_file} for common errors"
        return 0
    fi
    while IFS= read -r pattern; do
        [[ -z "$pattern" ]] && continue
        problem "${log_file} recent tail contains common error pattern: ${pattern}"
    done <<< "$log_scan_out"
    [[ -z "$log_scan_out" ]] && ok "No common error found in the recent ${log_file}"
    return 0
}

