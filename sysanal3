# ---------------------------------------------------------------------------
# Cluster inventory helpers
# ---------------------------------------------------------------------------
MODULES_ON_NODE=""
MODULES=""
NODE_ID=""
IS_LEADER=0
CLUSTER_ROLE="unknown"
PUBLIC_IP_SOURCE=""
SUBSCRIPTION_SYSTEM_ID=""
declare -A CLUSTER_MODULE_NODE=()  # every module ID in the cluster -> node ID
declare -A NODE_VPN_IP=()          # node ID -> VPN address
declare -A VPN_IP_NODE=()          # VPN address -> node ID

# Module IDs on this node whose image name (field 4 of MODULES_ON_NODE) is $1.
get_modules_by_name() {
    [[ -n "$MODULES_ON_NODE" ]] || return 0
    awk -F'|' -v name="$1" '$4 == name {print $1}' <<< "$MODULES_ON_NODE"
}

# Join "count name" lines as "name (count), ...".
format_top_counts() {
    awk '{ printf "%s%s (%s)", sep, $2, $1; sep = ", " }'
}

human_bytes() {
    awk -v b="$1" 'BEGIN {
        split("B KiB MiB GiB TiB", u, " "); i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        if (i == 1) printf "%d %s\n", b, u[i]; else printf "%.1f %s\n", b, u[i]
    }'
}

# Convert Podman sizes such as "15.71GB" or "161.8MB (3%)" to bytes.
size_to_bytes() {
    awk -v s="$1" 'BEGIN {
        if (!match(s, /^[0-9.]+/)) exit 1
        n = substr(s, 1, RLENGTH); u = toupper(substr(s, RLENGTH + 1)); m = 1
        if (u ~ /^K/) m = 1e3; else if (u ~ /^M/) m = 1e6; else if (u ~ /^G/) m = 1e9; else if (u ~ /^T/) m = 1e12
        printf "%.0f\n", n * m
    }'
}

journal_errors_command() {
    timeout 30s journalctl -p 0..3 --since "-${JOURNAL_SCAN_HOURS}h" -n "$LOG_SCAN_MAX_LINES" \
        -q --no-pager -o short-unix </dev/null 2>/dev/null
}

# Slow, independent commands run while other checks proceed.
start_background_jobs() {
    BG_DIR=$(mktemp -d 2>/dev/null) || { BG_DIR=""; return 0; }
    # shellcheck disable=SC2064
    trap "rm -rf -- '$BG_DIR'" EXIT
    if command -v podman >/dev/null 2>&1; then
        start_query podman-df timeout 120s podman system df --format '{{.Type}}|{{.Size}}|{{.Reclaimable}}'
    fi
    if command -v needs-restarting >/dev/null 2>&1; then
        start_query reboot timeout 120s needs-restarting -r
    fi
    if command -v journalctl >/dev/null 2>&1; then
        start_query journal journal_errors_command
    fi
}

# Run module-context queries in parallel: first contexts, then runtime data
# that depends on the execution UID, plus NethVoice and proxy snapshots.
prefetch_module_contexts() {
    local mod
    [[ -n "$BG_DIR" ]] || return 0
    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        start_query "context.$mod" module_context_command "$mod"
    done <<< "$MODULES"
}

prefetch_module_runtime() {
    local mod
    [[ -n "$BG_DIR" ]] || return 0
    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        resolve_module_runtime "$mod" || continue
        start_query "containers.$mod" module_containers_command "$mod"
        start_query "services.$mod" module_services_command "$mod"
    done <<< "$MODULES"
    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        prefetch_snapshot freepbx "$mod"
        prefetch_snapshot mariadb "$mod"
    done <<< "$(get_modules_by_name nethvoice)"
    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        prefetch_snapshot proxy "$mod"
    done <<< "$(get_modules_by_name nethvoice-proxy)"
}

# Read local node identity, cluster role and the module inventory from Redis.
discover_node_and_modules() {
    local module_node_raw prev_key="" line mod_id mod_node image_url source version module role
    # NODE_ID is stored in /var/lib/nethserver/node/state/environment
    NODE_ID=$(grep -oP '^NODE_ID=\K.*' /var/lib/nethserver/node/state/environment 2>/dev/null || true)
    if [[ -z "$NODE_ID" ]]; then
        # Fallback: extract from AGENT_ID in agent.env (e.g. "node/1" -> "1")
        NODE_ID=$(grep -oP '^AGENT_ID=node/\K\d+' /var/lib/nethserver/node/state/agent.env 2>/dev/null || true)
    fi
    if [[ -z "$NODE_ID" ]]; then
        problem "Cannot determine node ID (checked /var/lib/nethserver/node/state/environment and agent.env)"
        NODE_ID="1"
    fi

    # The leader runs the Redis master; workers run read-only replicas.
    role=$(redis-cli --raw ROLE </dev/null 2>/dev/null | head -1)
    case "$role" in
        master) IS_LEADER=1; CLUSTER_ROLE=leader ;;
        slave|replica) IS_LEADER=0; CLUSTER_ROLE=worker ;;
        *)
            if [[ "$NODE_ID" == 1 ]]; then IS_LEADER=1; CLUSTER_ROLE=leader; else IS_LEADER=0; CLUSTER_ROLE=worker; fi
            warning "Cannot determine the cluster role from Redis ROLE; assuming ${CLUSTER_ROLE} from node ID ${NODE_ID}"
            ;;
    esac
    load_cluster_nodes
    info "Node ${NODE_ID} is the cluster ${CLUSTER_ROLE}; ${#NODE_VPN_IP[@]} node(s) registered in the cluster"

    # Redis on workers runs as a replica: all cluster/* and module/* keys are
    # replicated from the leader, so read operations work everywhere.
    # Output format per line: id|source|version|module
    MODULES_ON_NODE=""
    CLUSTER_MODULE_NODE=()
    local -a local_ids=() image_urls=()
    local i
    module_node_raw=$(redis-cli --raw HGETALL cluster/module_node </dev/null 2>/dev/null || true)
    if [[ -n "$module_node_raw" ]]; then
        # HGETALL returns alternating key/value lines: module_id\nnode_id\n...
        while IFS= read -r line; do
            if [[ -z "$prev_key" ]]; then
                prev_key="$line"
                continue
            fi
            mod_id="$prev_key"
            mod_node="$line"
            prev_key=""
            CLUSTER_MODULE_NODE["$mod_id"]="$mod_node"
            [[ "$mod_node" == "$NODE_ID" ]] && local_ids+=("$mod_id")
        done <<< "$module_node_raw"
        if (( ${#local_ids[@]} > 0 )); then
            mapfile -t image_urls < <(printf 'HGET module/%s/environment IMAGE_URL\n' "${local_ids[@]}" | redis_batch)
        fi
        for i in "${!local_ids[@]}"; do
            mod_id="${local_ids[$i]}"
            image_url="${image_urls[$i]:-}"
            [[ -z "$image_url" ]] && continue
            # Parse: source = URL without tag, version = tag, module = last path component of source
            source="${image_url%:*}"
            version="${image_url##*:}"
            module="${source##*/}"
            MODULES_ON_NODE+="${mod_id}|${source}|${version}|${module}"$'\n'
        done
        MODULES_ON_NODE=$(echo "$MODULES_ON_NODE" | sort | sed '/^$/d')
    else
        warning "Cannot retrieve installed modules from Redis"
    fi
    MODULES=$(echo "$MODULES_ON_NODE" | cut -d'|' -f1 | grep -v '^$' || true)
}

load_cluster_nodes() {
    local key i
    local -a nodes=() ips=()
    NODE_VPN_IP=()
    VPN_IP_NODE=()
    while IFS= read -r key; do
        [[ "$key" =~ ^node/([0-9]+)/vpn$ ]] && nodes+=("${BASH_REMATCH[1]}")
    done < <(redis-cli --raw --scan --pattern 'node/*/vpn' </dev/null 2>/dev/null)
    (( ${#nodes[@]} > 0 )) || return 0
    mapfile -t ips < <(printf 'HGET node/%s/vpn ip_address\n' "${nodes[@]}" | redis_batch)
    for i in "${!nodes[@]}"; do
        NODE_VPN_IP["${nodes[$i]}"]="${ips[$i]:-}"
        [[ -n "${ips[$i]:-}" ]] && VPN_IP_NODE["${ips[$i]}"]="${nodes[$i]}"
    done
}

