PROXY_SNAPSHOT_SCRIPT=$(cat <<'EOF'
section dispatcher podman exec kamailio kamcmd dispatcher.list
section rtpengine podman exec rtpengine rtpengine-ctl list numsessions
EOF
)

declare -A SNAPSHOT_STATUS=()
declare -A SNAPSHOT_OUTPUT=()
declare -A SNAPSHOT_RC=()

# Parse snapshot output into SNAPSHOT_OUTPUT/SNAPSHOT_RC keyed "<id>|<section>".
store_snapshot() {
    local id="$1" marker="$2" output="$3" line name rc current=""
    SNAPSHOT_STATUS["$id"]=1
    while IFS= read -r line; do
        if [[ "$line" == "$marker "* ]]; then
            read -r _ name rc <<< "$line"
            current="$id|$name"
            SNAPSHOT_RC["$current"]="$rc"
            SNAPSHOT_OUTPUT["$current"]=""
            SNAPSHOT_STATUS["$id"]=0
        elif [[ -n "$current" ]]; then
            SNAPSHOT_OUTPUT["$current"]+="$line"$'\n'
        fi
    done <<< "$output"
    return "${SNAPSHOT_STATUS[$id]}"
}

new_snapshot_marker() {
    printf '@@sysanal3-%s%s%s\n' "$RANDOM" "$RANDOM" "$RANDOM"
}

declare -A SNAPSHOT_MARKERS=()

freepbx_snapshot_command() {
    timeout 90s runagent -m "$1" podman exec freepbx sh -c "${SNAPSHOT_PRELUDE}"$'\n'"${FREEPBX_SNAPSHOT_SCRIPT}" \
        sh "$2" "$NV_CHANNEL_MAX_AGE" </dev/null 2>/dev/null
}

mariadb_snapshot_command() {
    # mysqlcheck reads every table; it is slow on large CDR databases by design.
    timeout 1800s runagent -m "$1" podman exec mariadb sh -c "${SNAPSHOT_PRELUDE}"$'\n'"${MARIADB_SNAPSHOT_SCRIPT}" \
        sh "$2" </dev/null 2>/dev/null
}

proxy_snapshot_command() {
    timeout "${RUNAGENT_TIMEOUT}s" runagent -m "$1" sh -c "${SNAPSHOT_PRELUDE}"$'\n'"${PROXY_SNAPSHOT_SCRIPT}" \
        sh "$2" </dev/null 2>/dev/null
}

# Start a snapshot in the background; collect_snapshot consumes it later.
prefetch_snapshot() {
    local kind="$1" mod="$2" marker
    marker=$(new_snapshot_marker)
    SNAPSHOT_MARKERS["$kind:$mod"]="$marker"
    start_query "snapshot.$kind.$mod" "${kind}_snapshot_command" "$mod" "$marker"
}

# Collect once per run (prefetched or inline); forget_snapshot forces a new one.
collect_snapshot() {
    local kind="$1" mod="$2" id="$1:$2" marker output
    [[ -n "${SNAPSHOT_STATUS[$id]+cached}" ]] && return "${SNAPSHOT_STATUS[$id]}"
    marker="${SNAPSHOT_MARKERS[$id]:-}"
    if [[ -n "$marker" ]] && fetch_query "snapshot.$kind.$mod"; then
        output="$QUERY_OUTPUT"
    else
        marker=$(new_snapshot_marker)
        output=$("${kind}_snapshot_command" "$mod" "$marker")
    fi
    store_snapshot "$id" "$marker" "$output"
}

collect_freepbx_snapshot() { collect_snapshot freepbx "$1"; }
collect_mariadb_snapshot() { collect_snapshot mariadb "$1"; }
collect_proxy_snapshot() { collect_snapshot proxy "$1"; }

forget_snapshot() {
    local id="$1" key
    unset 'SNAPSHOT_STATUS[$id]' 'SNAPSHOT_MARKERS[$id]'
    for key in "${!SNAPSHOT_RC[@]}"; do
        [[ "$key" == "$id|"* ]] || continue
        unset 'SNAPSHOT_RC[$key]' 'SNAPSHOT_OUTPUT[$key]'
    done
}

# Print one section; the status is the in-container command status, or 127
# when the snapshot (or that section) is unavailable.
snapshot_section() {
    local key="$1|$2"
    [[ -n "${SNAPSHOT_RC[$key]+x}" ]] || return 127
    printf '%s' "${SNAPSHOT_OUTPUT[$key]}"
    return "${SNAPSHOT_RC[$key]}"
}

freepbx_section() {
    collect_freepbx_snapshot "$1"
    snapshot_section "freepbx:$1" "$2"
}

mariadb_section() {
    collect_mariadb_snapshot "$1"
    snapshot_section "mariadb:$1" "$2"
}

check_nethvoice_asterisk_runtime() {
    local mod="$1" output version uptime reload_age channels calls
    if output=$(freepbx_section "$mod" version) &&
        version=$(printf '%s\n' "$output" | grep -oE '^Asterisk [0-9][0-9A-Za-z._+-]*' | head -1) && [[ -n "$version" ]]; then
        info "${mod}: ${version}"
    else
        warning "${mod}: cannot query Asterisk version (FreePBX/Asterisk may not be running)"
        return 0
    fi
    if output=$(freepbx_section "$mod" uptime); then
        uptime=$(printf '%s\n' "$output" | sed -nE 's/^System uptime: *([0-9]+) *$/\1/p')
        reload_age=$(printf '%s\n' "$output" | sed -nE 's/^Last reload: *([0-9]+) *$/\1/p')
        [[ "$reload_age" =~ ^[0-9]+$ ]] || reload_age=""
        if [[ "$uptime" =~ ^[0-9]+$ ]]; then
            info "${mod}: Asterisk uptime ${uptime}s${reload_age:+, last reload ${reload_age}s ago}"
        else
            warning "${mod}: invalid Asterisk uptime data"
        fi
    else
        warning "${mod}: cannot query Asterisk uptime"
    fi
    if output=$(freepbx_section "$mod" channels); then
        channels=$(printf '%s\n' "$output" | sed -nE 's/^([0-9]+) active channels? *$/\1/p')
        calls=$(printf '%s\n' "$output" | sed -nE 's/^([0-9]+) active calls? *$/\1/p')
        if [[ "$channels" =~ ^[0-9]+$ && "$calls" =~ ^[0-9]+$ ]]; then
            info "${mod}: Asterisk active channels: ${channels}, active calls: ${calls}"
        else
            warning "${mod}: invalid Asterisk active-call counts"
        fi
    else
        warning "${mod}: cannot query Asterisk active-call counts"
    fi
    return 0
}

check_nethvoice_pjsip_contacts() {
    local mod="$1" contact_count
    if contact_count=$(freepbx_section "$mod" contacts) && contact_count="${contact_count%$'\n'}" &&
        [[ "$contact_count" =~ ^[0-9]+$ ]]; then
        info "${mod}: PJSIP contact objects: ${contact_count}"
        if [[ "$contact_count" == 0 ]]; then
            warning "${mod}: Asterisk running but zero PJSIP contacts"
        fi
    else
        warning "${mod}: cannot retrieve PJSIP contact count"
    fi
    return 0
}

check_nethvoice_pjsip_endpoints() {
    local mod="$1" output total unavailable extra
    if output=$(freepbx_section "$mod" endpoints) && read -r total unavailable extra <<< "$output" &&
        [[ "$total" =~ ^[0-9]+$ && "$unavailable" =~ ^[0-9]+$ && -z "$extra" ]]; then
        info "${mod}: PJSIP endpoints: ${total} configured, ${unavailable} unavailable"
    else
        warning "${mod}: cannot retrieve PJSIP endpoint counts"
    fi
    return 0
}

check_nethvoice_trunk_registrations() {
    local mod="$1" output total failed extra
    if output=$(freepbx_section "$mod" registrations) && read -r total failed extra <<< "$output" &&
        [[ "$total" =~ ^[0-9]+$ && "$failed" =~ ^[0-9]+$ && -z "$extra" ]]; then
        if (( failed > 0 )); then
            problem "${mod}: ${failed} of ${total} outbound SIP registration(s) are not registered (Rejected/Unregistered/Stopped)"
        elif (( total > 0 )); then
            ok "${mod}: all ${total} outbound SIP registration(s) are registered"
        else
            info "${mod}: no outbound SIP registrations configured"
        fi
    else
        warning "${mod}: cannot retrieve outbound SIP registration status"
    fi
    return 0
}

check_nethvoice_long_channels() {
    local mod="$1" output total long extra
    if output=$(freepbx_section "$mod" long_channels) && read -r total long extra <<< "$output" &&
        [[ "$total" =~ ^[0-9]+$ && "$long" =~ ^[0-9]+$ && -z "$extra" ]]; then
        if (( long > 0 )); then
            warning "${mod}: ${long} of ${total} active channel(s) older than $(format_duration "$NV_CHANNEL_MAX_AGE") (possibly stuck calls)"
        else
            ok "${mod}: no channels older than $(format_duration "$NV_CHANNEL_MAX_AGE")"
        fi
    else
        warning "${mod}: cannot retrieve active channel durations"
    fi
    return 0
}

get_listener_lines_by_port() {
    local port="$1" protocol="${2:-any}"
    {
        if [[ "$protocol" != udp ]]; then
            ss -H -ltnp "( sport = :${port} )" 2>/dev/null
        fi
        if [[ "$protocol" != tcp ]]; then
            ss -H -lunp "( sport = :${port} )" 2>/dev/null
        fi
    } | sed '/^$/d'
}

get_listener_processes_by_port() {
    local port="$1" protocol="${2:-any}"
    local listeners
    listeners=$(get_listener_lines_by_port "$port" "$protocol")
    if [[ -z "$listeners" ]]; then
        return
    fi
    echo "$listeners" | grep -oE '"[^"]+"' | tr -d '"' | sort -u | xargs
}

check_port() {
    local desc="$1" port="$2"
    local listeners processes
    listeners=$(get_listener_lines_by_port "$port")
    if [[ -n "$listeners" ]]; then
        processes=$(get_listener_processes_by_port "$port")
        if [[ -n "$processes" ]]; then
            ok "${desc}: port ${port} is listening (processes: ${processes})"
        else
            ok "${desc}: port ${port} is listening"
        fi
    else
        problem "${desc}: port ${port} is NOT listening"
    fi
}

check_port_owner() {
    local desc="$1" port="$2" expected_regex="$3" expected_service="$4" protocol="${5:-any}"
    local listeners processes
    listeners=$(get_listener_lines_by_port "$port" "$protocol")
    processes=$(get_listener_processes_by_port "$port" "$protocol")

    if [[ -z "$listeners" ]]; then
        problem "${desc}: port ${port} is NOT listening"
        return 1
    fi

    if [[ -n "$expected_regex" ]] && ! echo " ${processes} " | grep -qiE "$expected_regex"; then
        problem "${desc}: port ${port} is used by [${processes:-unknown}] instead of ${expected_service}"
        return 1
    fi

    ok "${desc}: port ${port} is listening (processes: ${processes:-unknown})"
    return 0
}

