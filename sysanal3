# Runs in the CrowdSec module context with local addresses as arguments.
CROWDSEC_QUERY_SCRIPT=$(cat <<'EOF'
container=$(podman ps --format '{{.Names}}' | grep -i crowdsec | head -1)
[ -n "$container" ] || exit 4
podman exec -i "$container" sh -s -- "$@" <<'INNER'
for ip; do
    result=$(cscli decisions list -i "$ip" -o raw 2>/dev/null | tail -n +2 | head -1)
    [ -z "$result" ] || printf '%s\t%s\n' "$ip" "$result"
done
INNER
EOF
)

check_crowdsec() {
    local cs_mod output rc ip result blocked_found=0
    local -a local_ips=()
    cs_mod=$(get_modules_by_name crowdsec | head -1)
    if [[ -z "$cs_mod" ]]; then
        info "No CrowdSec module found, skipping"
        return 0
    fi
    warning "CrowdSec module found: ${cs_mod} (may cause connectivity issues)"
    mapfile -t local_ips < <(ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 |
        grep -v '^127\.' | grep -v '^::1$' | sort -u)
    if (( ${#local_ips[@]} == 0 )); then
        warning "Could not determine local IP addresses"
        return 0
    fi
    output=$(timeout 60s runagent -m "$cs_mod" sh -c "$CROWDSEC_QUERY_SCRIPT" sh "${local_ips[@]}" </dev/null 2>/dev/null)
    rc=$?
    if [[ "$rc" == 4 ]]; then
        warning "CrowdSec container not found in module ${cs_mod}"
        return 0
    elif [[ "$rc" != 0 && -z "$output" ]]; then
        warning "Cannot query CrowdSec decisions in module ${cs_mod}"
        return 0
    fi
    while IFS=$'\t' read -r ip result; do
        [[ -z "$ip" ]] && continue
        problem "CrowdSec: local IP ${ip} is BLOCKED"
        echo "  ${result}"
        blocked_found=1
    done <<< "$output"
    (( blocked_found )) || ok "CrowdSec: no local IPs are blocked (checked ${#local_ips[@]} addresses)"
}

