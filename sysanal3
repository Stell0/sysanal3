LOG_SCAN_MAX_LINES=20000       # Inspect at most this many lines within that tail
LOG_SIZE_WARNING_BYTES=1073741824  # Warn when the active /var/log/messages exceeds 1 GiB
JOURNAL_SCAN_HOURS=24          # Error-priority journal window
JOURNAL_NOISY_SOURCE_COUNT=1000    # Warn when one source logs this many error entries in the window
RESTART_THRESHOLD=5            # Container/service restarts above this count flag a problem
RESTART_RECENT_SECONDS=86400   # Restart bursts older than this (unit stable since) are informational
RUNAGENT_TIMEOUT=15            # Seconds allowed for each module-context runagent query
FS_WARNING_PCT=85              # Filesystem block/inode usage warning threshold
FS_PROBLEM_PCT=95              # Filesystem block/inode usage problem threshold
MEMORY_WARNING_PCT=90          # Memory usage based on MemAvailable
MEMORY_PROBLEM_PCT=95          # Severe memory usage threshold
DNS_SLOW_MS=2000               # DNS resolution slower than this (ms) flags a problem
QUEUE_RINGALL_MAX_QUEUES=3     # Warn if ringall strategy is used by more than this number of queues
QUEUE_RINGALL_MAX_AGENTS=5     # Warn if any ringall queue has more than this number of agents
NV_CHANNEL_MAX_AGE=14400       # Asterisk channels older than this (seconds) may be stuck calls
NV_ASTDB_MAX_AGE=1200          # Probe AstDB writes only after 20 minutes without file changes
