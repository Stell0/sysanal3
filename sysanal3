check_module_version_github() {
    local mod_id="$1" mod_source="$2" mod_version="$3" mod_name="$4"
    local image_path org github_repo latest_tag

    if [[ -z "$mod_source" || -z "$mod_version" ]]; then
        warning "${mod_id}: missing source or version info"
        return
    fi

    # Derive GitHub repo from source image URL
    # e.g. ghcr.io/nethserver/traefik -> nethserver/ns8-traefik
    # e.g. ghcr.io/nethesis/nethvoice -> nethesis/ns8-nethvoice
    image_path="${mod_source#*/}"    # drop registry host (ghcr.io/)
    org="${image_path%%/*}"          # e.g. "nethserver" or "nethesis"
    github_repo="${org}/ns8-${mod_name}"

    latest_tag=$(curl -sf --max-time 10 \
        "https://api.github.com/repos/${github_repo}/releases/latest" \
        | grep -oP '"tag_name"\s*:\s*"\K[^"]+' || true)

    if [[ -z "$latest_tag" ]]; then
        info "${mod_id}: cannot fetch latest release for ${github_repo} (installed: ${mod_version})"
        return
    fi

    if [[ "$mod_version" != "$latest_tag" ]]; then
        warning "${mod_id}: installed ${mod_version}, latest is ${latest_tag} (repo: ${github_repo})"
    else
        ok "${mod_id}: up to date (${mod_version})"
    fi
}

section_connectivity() {
    header "Pre-check: Internet connectivity"
    if (( OFFLINE )); then
        info "Internet checks skipped (--offline)"
        INTERNET_OK=0
    elif ping -qc 1 -W 3 sos.nethesis.it &>/dev/null; then
        ok "Internet connectivity OK (sos.nethesis.it reachable)"
    else
        warning "No internet connectivity (sos.nethesis.it unreachable) — GitHub version checks will be skipped"
        INTERNET_OK=0
    fi
}

section_general_system_data() {
    local nameservers filenr used max rootfs cpu_cores load_avg_1 tz cluster_uuid
    header "General System Data"

    info_always "IP addresses: ${LOCAL_IPS_DISPLAY}"
    if (( OFFLINE )); then
        info_always "Public IP: lookup skipped (--offline)"
    else
        info_always "Public IP: ${PUBLIC_IP:-unavailable}"
        [[ -z "$PUBLIC_IP" ]] && warning "Public IP could not be determined; hairpin NAT checks will be skipped"
    fi

    nameservers=$(grep -E '^nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}' | xargs || true)
    info_always "DNS nameservers: ${nameservers:-N/A}"
    info_always "Hostname: $(hostname -f 2>/dev/null || hostname 2>/dev/null || echo 'N/A')"

    filenr=$(cat /proc/sys/fs/file-nr 2>/dev/null || true)
    if [[ -n "$filenr" ]]; then
        used=$(echo "$filenr" | awk '{print $1}')
        max=$(echo "$filenr" | awk '{print $3}')
        info_always "Open file descriptors: ${used} / ${max}"
        if [[ "$max" -gt 0 ]] && (( used * 100 / max >= 90 )); then
            problem "Open file descriptors at ${used}/${max} (>= 90%)"
        fi
    fi

    rootfs=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s used / %s total (%s full)", $3, $2, $5}')
    info_always "Root filesystem: ${rootfs:-N/A}"
    check_filesystem_usage "Root filesystem" /
    check_readonly_mounts

    cpu_cores=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || true)
    load_avg_1=$(awk '{print $1}' /proc/loadavg 2>/dev/null || true)
    if [[ -n "$cpu_cores" && -n "$load_avg_1" ]]; then
        info_always "CPU load average (1m): ${load_avg_1} on ${cpu_cores} core(s)"
        if awk -v load_avg="$load_avg_1" -v cores="$cpu_cores" 'BEGIN { exit !(load_avg > (2 * cores)) }'; then
            problem "CPU load average is ${load_avg_1} on ${cpu_cores} core(s) (> 2x core count)"
        elif awk -v load_avg="$load_avg_1" -v cores="$cpu_cores" 'BEGIN { exit !(load_avg > cores) }'; then
            warning "CPU load average is ${load_avg_1} on ${cpu_cores} core(s) (> core count)"
        fi
    fi

    # Memory and swap pressure (uses available memory, including reclaimable cache)
    check_node_memory /proc/meminfo

    info_always "Uptime: $(uptime -p 2>/dev/null || uptime | sed 's/.*up/up/' || echo 'N/A')"
    tz=$(timedatectl 2>/dev/null | grep -i 'time zone' | awk '{print $3, $4, $5}' || true)
    info_always "Timezone: ${tz:-N/A}"
    check_time_sync
    check_reboot_required
    check_selinux_denials

    { IFS= read -r SUBSCRIPTION_SYSTEM_ID; IFS= read -r cluster_uuid; } < <(
        printf 'HGET cluster/subscription system_id\nGET cluster/uuid\n' | redis_batch)
    if [[ -z "$SUBSCRIPTION_SYSTEM_ID" ]]; then
        warning "Cluster subscription system_id is empty or missing"
    else
        info_always "Subscription system_id: ${SUBSCRIPTION_SYSTEM_ID}"
    fi
    info_always "Cluster UUID: ${cluster_uuid:-N/A}"
}

