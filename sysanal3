# JSON string with quotes, backslashes and control characters escaped.
json_string() {
    local s="$1"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    s=$(printf '%s' "$s" | tr -d '\000-\010\013\014\016-\037')
    printf '"%s"' "$s"
}

json_array() {
    local item first=1
    printf '['
    for item in "$@"; do
        (( first )) || printf ','
        first=0
        json_string "$item"
    done
    printf ']'
}

print_json_report() {
    printf '{"tool":"sysanal3","date":%s,"hostname":%s,"node_id":%s,"cluster_role":%s,' \
        "$(json_string "$(date -Iseconds)")" "$(json_string "$(hostname -f 2>/dev/null || hostname)")" \
        "$(json_string "$NODE_ID")" "$(json_string "$CLUSTER_ROLE")"
    printf '"problem_count":%d,"warning_count":%d,"problems":%s,"warnings":%s}\n' \
        "$PROBLEMS" "$WARNINGS" "$(json_array "${PROBLEM_MSGS[@]}")" "$(json_array "${WARNING_MSGS[@]}")"
}

print_summary() {
    local msg
    echo ""
    echo -e "${BOLD}=========================================${NC}"
    echo -e "${BOLD}Summary (Node ${NODE_ID}, ${CLUSTER_ROLE})${NC}"
    echo -e "  Problems: ${RED}${PROBLEMS}${NC}"
    echo -e "  Warnings: ${YELLOW}${WARNINGS}${NC}"
    echo -e "${BOLD}=========================================${NC}"

    if [[ ${#PROBLEM_MSGS[@]} -gt 0 ]]; then
        echo ""
        echo -e "${RED}${BOLD}Problems:${NC}"
        for msg in "${PROBLEM_MSGS[@]}"; do
            echo -e "  ${RED}[PROBLEM]${NC} ${msg}"
        done
    fi

    if [[ ${#WARNING_MSGS[@]} -gt 0 ]]; then
        echo ""
        echo -e "${YELLOW}${BOLD}Warnings:${NC}"
        for msg in "${WARNING_MSGS[@]}"; do
            echo -e "  ${YELLOW}[WARNING]${NC} ${msg}"
        done
    fi
}

usage() {
    cat <<'EOF'
Usage: sysanal3 [--silent] [--json] [--offline]

  -s, --silent   Suppress OK and most INFO messages
  --json         Print a JSON report on stdout; human-readable output goes to stderr
  --offline      Skip external lookups and active probes (public IP services,
                 GitHub, TLS handshakes, hairpin NAT, update and subscription queries)
  --worker       Accepted for compatibility; the node role is detected automatically
EOF
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--silent) SILENT=1 ;;
            --json) JSON_OUTPUT=1 ;;
            --offline) OFFLINE=1 ;;
            --worker) ;;
            -h|--help) usage; exit 0 ;;
            *) ;;
        esac
        shift
    done
}

main() {
    parse_args "$@"

    if [[ $EUID -ne 0 ]]; then
        echo "This script must be run as root" >&2
        exit 1
    fi

    # Keep stdout for the JSON document; human-readable output goes to stderr.
    if (( JSON_OUTPUT )); then
        exec 3>&1 1>&2
    fi

    echo -e "${BOLD}sysanal3 - NethServer 8 System Analyzer V3${NC}"
    echo "========================================="
    echo "Date: $(date)"

    start_background_jobs
    init_network_identity

    section_connectivity
    section_general_system_data

    header "Check: sngrep long-running instances"
    check_sngrep_instances

    section_logs
    section_modules
    section_cluster
    section_module_versions
    section_module_runtime
    section_nethvoice
    section_listening_ports

    header "Check: CrowdSec IP blocking"
    check_crowdsec

    print_summary
    if (( JSON_OUTPUT )); then
        print_json_report >&3
    fi

    if [[ $PROBLEMS -gt 0 ]]; then
        exit 1
    fi
    exit 0
}

# Sourcing defines helpers for local tests without executing the analyzer.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

main "$@"
