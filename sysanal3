# Host checks
# ---------------------------------------------------------------------------
# Block and inode usage of the filesystem containing $2.
check_filesystem_usage() {
    local label="$1" path="$2" pct ipct
    pct=$(df -P -- "$path" 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5}')
    if [[ "$pct" =~ ^[0-9]+$ ]]; then
        if (( pct >= FS_PROBLEM_PCT )); then
            problem "${label} usage at ${pct}% (>= ${FS_PROBLEM_PCT}%)"
        elif (( pct >= FS_WARNING_PCT )); then
            warning "${label} usage at ${pct}% (>= ${FS_WARNING_PCT}%)"
        fi
    fi
    # Some filesystems (e.g. btrfs) report "-" for inodes.
    ipct=$(df -iP -- "$path" 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5}')
    if [[ "$ipct" =~ ^[0-9]+$ ]]; then
        if (( ipct >= FS_PROBLEM_PCT )); then
            problem "${label} inode usage at ${ipct}% (>= ${FS_PROBLEM_PCT}%)"
        elif (( ipct >= FS_WARNING_PCT )); then
            warning "${label} inode usage at ${ipct}% (>= ${FS_WARNING_PCT}%)"
        fi
    fi
    return 0
}

check_readonly_mounts() {
    local target fstype options found=0
    while read -r target fstype options; do
        case "$fstype" in ext2|ext3|ext4|xfs|btrfs) ;; *) continue ;; esac
        [[ ",${options}," == *,ro,* ]] || continue
        problem "Filesystem ${target} (${fstype}) is mounted read-only"
        found=1
    done < <(findmnt -rn -o TARGET,FSTYPE,OPTIONS 2>/dev/null)
    (( found )) || ok "No local disk filesystem is mounted read-only"
    return 0
}

check_time_sync() {
    local synced
    synced=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
    case "$synced" in
        yes) ok "System clock is NTP-synchronized" ;;
        no) warning "System clock is not NTP-synchronized (TLS, SIP, tokens and backups depend on correct time)" ;;
        *) info "Cannot determine NTP synchronization state" ;;
    esac
}

check_reboot_required() {
    local rc
    if fetch_query reboot; then
        rc="$QUERY_RC"
        case "$rc" in
            0) ok "No reboot required by installed updates" ;;
            1) warning "Reboot required: updated core packages are installed but not running (running kernel $(uname -r))" ;;
            *) info "Could not determine whether a reboot is required (needs-restarting exit status ${rc:-unknown})" ;;
        esac
    elif [[ -e /run/reboot-required ]]; then
        warning "Reboot required (/run/reboot-required is present)"
    elif command -v dpkg >/dev/null 2>&1; then
        ok "No reboot required by installed updates"
    else
        info "Reboot requirement cannot be determined (needs-restarting is not available)"
    fi
}

check_selinux_denials() {
    local mode out count top
    command -v getenforce >/dev/null 2>&1 || return 0
    mode=$(getenforce 2>/dev/null)
    [[ "$mode" == Enforcing || "$mode" == Permissive ]] || return 0
    if ! command -v ausearch >/dev/null 2>&1; then
        info "SELinux ${mode}: ausearch is not available; denial check skipped"
        return 0
    fi
    # ausearch exits 1 when nothing matches.
    out=$(timeout 20s ausearch -m AVC,USER_AVC -ts today </dev/null 2>/dev/null)
    count=$(grep -cE '^type=(AVC|USER_AVC) ' <<< "$out")
    if (( count > 0 )); then
        top=$(grep -oE 'comm="[^"]+"' <<< "$out" | sed 's/^comm="//; s/"$//' | sort | uniq -c | sort -rn | head -3 | format_top_counts)
        warning "SELinux (${mode}): ${count} denial(s) today${top:+ (top processes: ${top})}"
    else
        ok "SELinux (${mode}): no denials today"
    fi
}

check_redis_persistence() {
    local out rdb aof_enabled aof
    if ! out=$(redis-cli info persistence </dev/null 2>/dev/null | tr -d '\r') || [[ -z "$out" ]]; then
        warning "Cannot query Redis persistence status"
        return 0
    fi
    rdb=$(sed -n 's/^rdb_last_bgsave_status://p' <<< "$out")
    aof_enabled=$(sed -n 's/^aof_enabled://p' <<< "$out")
    aof=$(sed -n 's/^aof_last_write_status://p' <<< "$out")
    if [[ -n "$rdb" && "$rdb" != ok ]]; then
        problem "Redis last background save failed (rdb_last_bgsave_status=${rdb}); cluster data may not persist"
    elif [[ "$aof_enabled" == 1 && "$aof" != ok ]]; then
        problem "Redis append-only file write failed (aof_last_write_status=${aof:-unknown})"
    else
        ok "Redis persistence is healthy"
    fi
}

check_podman_storage() {
    local rc type size reclaimable images_size="" images_reclaimable="" volumes_size="" bytes
    if ! fetch_query podman-df; then
        info "Rootful Podman storage usage is not available"
        return 0
    fi
    rc="$QUERY_RC"
    if [[ "$rc" != 0 ]]; then
        info "Rootful Podman storage usage could not be computed (podman system df exit status ${rc:-unknown})"
        return 0
    fi
    while IFS='|' read -r type size reclaimable; do
        case "$type" in
            Images) images_size="$size"; images_reclaimable="$reclaimable" ;;
            "Local Volumes") volumes_size="$size" ;;
        esac
    done <<< "$QUERY_OUTPUT"
    info_always "Rootful Podman storage: images ${images_size:-N/A} (reclaimable ${images_reclaimable:-N/A}), volumes ${volumes_size:-N/A}"
    bytes=$(size_to_bytes "${images_reclaimable%% *}") || return 0
    if [[ "$bytes" =~ ^[0-9]+$ ]] && (( bytes >= PODMAN_RECLAIMABLE_WARNING_BYTES )); then
        warning "Rootful Podman: ${images_reclaimable} of images are not used by any container; review them with 'podman images' and prune unused ones"
    fi
}

check_failed_system_services() {
    local unit found=0
    while read -r unit _; do
        [[ -z "$unit" ]] && continue
        problem "System unit ${unit} is failed"
        found=1
    done < <(systemctl list-units --failed --no-legend --no-pager --plain 2>/dev/null)
    (( found )) || ok "No failed system services"
}

check_sngrep_instances() {
    local sngrep_pids pid elapsed
    sngrep_pids=$(pgrep -x sngrep 2>/dev/null || true)
    if [[ -z "$sngrep_pids" ]]; then
        ok "No sngrep instances found"
        return 0
    fi
    while read -r pid; do
        elapsed=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
        if [[ -n "$elapsed" && "$elapsed" -gt 86400 ]]; then
            problem "sngrep (PID $pid) running for $((elapsed / 86400)) day(s)"
        else
            info "sngrep (PID $pid) running for less than 1 day"
        fi
    done <<< "$sngrep_pids"
}

# Program name of a syslog line in traditional or RFC 3339 format.
# shellcheck disable=SC2016
SYSLOG_PROGRAM_AWK='{ p = ($1 ~ /^[0-9][0-9][0-9][0-9]-/) ? $3 : $5; sub(/\[.*$/, "", p); sub(/:$/, "", p); if (p != "") c[p]++ }
    END { for (k in c) print c[k], k }'

check_log_file_size() {
    local log_file="${1:-/var/log/messages}" size top
    [[ -f "$log_file" ]] || return 0
    size=$(stat -c %s -- "$log_file" 2>/dev/null) || return 0
    if (( size >= LOG_SIZE_WARNING_BYTES )); then
        top=$(tail -c "$LOG_SCAN_MAX_BYTES" -- "$log_file" 2>/dev/null | tail -n "$LOG_SCAN_MAX_LINES" |
            awk "$SYSLOG_PROGRAM_AWK" | sort -rn | head -3 | format_top_counts)
        warning "${log_file} is $(human_bytes "$size") (>= $(human_bytes "$LOG_SIZE_WARNING_BYTES")); the bounded scan covers only its last $(human_bytes "$LOG_SCAN_MAX_BYTES")${top:+; top sources there: ${top}}"
    else
        info "${log_file} size: $(human_bytes "$size")"
    fi
}

# Error-priority journal entries in a time window: report sources by count
# and matching pattern names, never the records themselves.
check_journal_errors() {
    local out rc total identifiers top count ident pattern
    if ! command -v journalctl >/dev/null 2>&1; then
        info "journalctl is not available; journal scan skipped"
        return 0
    fi
    if fetch_query journal; then
        out="${QUERY_OUTPUT%$'\n'}"
        rc="$QUERY_RC"
    else
        out=$(journal_errors_command)
        rc=$?
    fi
    if [[ "$rc" != 0 && -z "$out" ]]; then
        warning "Could not read error-priority journal entries"
        return 0
    fi
    if [[ -z "$out" ]]; then
        ok "No error-priority journal entries in the last ${JOURNAL_SCAN_HOURS}h"
        return 0
    fi
    total=$(wc -l <<< "$out")
    # short-unix: "<timestamp> <host> <identifier>[pid]: message"
    identifiers=$(awk '{ i = $3; sub(/\[.*$/, "", i); sub(/:$/, "", i); if (i != "") c[i]++ }
        END { for (k in c) print c[k], k }' <<< "$out" | sort -rn)
    top=$(head -3 <<< "$identifiers" | format_top_counts)
    info "Journal: ${total} error-priority entries in the last ${JOURNAL_SCAN_HOURS}h (limit ${LOG_SCAN_MAX_LINES}); top sources: ${top}"
    while read -r count ident; do
        if [[ "$count" =~ ^[0-9]+$ ]] && (( count >= JOURNAL_NOISY_SOURCE_COUNT )); then
            warning "Journal: ${ident} logged ${count} error-priority entries in the last ${JOURNAL_SCAN_HOURS}h"
        fi
    done <<< "$identifiers"
    while IFS= read -r pattern; do
        [[ -z "$pattern" ]] && continue
        problem "Journal error entries (last ${JOURNAL_SCAN_HOURS}h) contain common error pattern: ${pattern}"
    done < <(match_log_patterns "$MESSAGES_LOG_ERROR_PATTERNS" <<< "$out")
    return 0
}

# ---------------------------------------------------------------------------
# Cluster checks
# ---------------------------------------------------------------------------
check_wireguard_peers() {
    local dump
    if ! command -v wg >/dev/null 2>&1; then
        info "wg command not available; cluster VPN checks skipped"
        return 0
    fi
    if ! ip link show wg0 >/dev/null 2>&1; then
        info "No wg0 interface; cluster VPN checks skipped"
        return 0
    fi
    if ! dump=$(timeout 10s wg show wg0 dump </dev/null 2>/dev/null); then
        warning "Cannot read WireGuard wg0 peer status"
        return 0
    fi
    evaluate_wireguard_peers "$dump" "$(date +%s)"
}

# $1: "wg show wg0 dump" output (interface line, then one tab-separated line
# per peer); $2: current epoch. Peers are named by matching VPN addresses.
evaluate_wireguard_peers() {
    local dump="$1" now="$2" first=1 total=0 healthy=0
    local pubkey allowed handshake ip node label age
    local -a ips=()
    local -A peered=()
    while IFS=$'\t' read -r pubkey _ _ allowed handshake _; do
        if (( first )); then first=0; continue; fi
        [[ -z "$pubkey" ]] && continue
        ((total++))
        label=""
        IFS=, read -r -a ips <<< "$allowed"
        for ip in "${ips[@]}"; do
            ip="${ip%/32}"
            node="${VPN_IP_NODE[$ip]:-}"
            if [[ -n "$node" ]]; then
                label+="${label:+, }node ${node} (${ip})"
                peered["$node"]=1
            fi
        done
        [[ -z "$label" ]] && label="peer ${allowed:-without allowed IPs}"
        if [[ ! "$handshake" =~ ^[0-9]+$ || "$handshake" == 0 ]]; then
            problem "Cluster VPN: ${label} never completed a WireGuard handshake (node down or stale)"
            continue
        fi
        age=$(( now - handshake ))
        if (( age > WG_HANDSHAKE_MAX_AGE )); then
            problem "Cluster VPN: ${label} last WireGuard handshake $(format_duration "$age") ago (node down or stale)"
        else
            ((healthy++))
            info "Cluster VPN: ${label} handshake $(format_duration "$age") ago"
        fi
    done <<< "$dump"
    # The leader peers with every node; workers need not peer with each other.
    if (( IS_LEADER )); then
        for node in "${!NODE_VPN_IP[@]}"; do
            [[ "$node" == "$NODE_ID" || -n "${peered[$node]+x}" ]] && continue
            warning "Cluster VPN: node ${node} is registered in Redis but has no WireGuard peer on the leader"
        done
    fi
    if (( total == 0 )); then
        info "Cluster VPN: no WireGuard peers"
    elif (( healthy == total )); then
        ok "Cluster VPN: all ${total} WireGuard peer(s) have a recent handshake"
    fi
    return 0
}

check_redis_replication() {
    local out link io
    out=$(redis-cli info replication </dev/null 2>/dev/null | tr -d '\r')
    link=$(sed -n 's/^master_link_status://p' <<< "$out")
    io=$(sed -n 's/^master_last_io_seconds_ago://p' <<< "$out")
    if [[ "$link" == up ]]; then
        ok "Redis replica is connected to the leader (last I/O ${io:-?}s ago)"
    else
        problem "Redis replica link to the leader is ${link:-unknown}: cluster data on this node may be stale"
    fi
}

backup_interval_seconds() {
    case "$1" in
        hourly) echo 3600 ;;
        daily) echo 86400 ;;
        weekly) echo 604800 ;;
        monthly) echo 2678400 ;;
        *) return 1 ;;
    esac
}

# Backups are cluster objects ("cluster/backup/<id>": name, enabled,
# instances, schedule_hint); per-module results are in
# "node/<node>/backup_status/<id>" as JSON with start, end and errors.
check_backups() {
    local keys key bid hint mid enabled_text existing stale status errors end interval max_age now found disabled_names label
    local -a bids=() values=() mods=() flags=() statuses=() requests=()
    local -A backup_name=() backup_enabled=() backup_instances=() backup_interval=() status_of=()
    local i request
    if ! keys=$(redis-cli --raw --scan --pattern 'cluster/backup/*' </dev/null 2>/dev/null); then
        warning "Cannot read backup configuration from Redis"
        return 0
    fi
    while IFS= read -r key; do
        bid="${key#cluster/backup/}"
        [[ "$bid" =~ ^[0-9]+$ ]] && bids+=("$bid")
    done <<< "$keys"
    if (( ${#bids[@]} > 0 )); then
        mapfile -t values < <(for bid in "${bids[@]}"; do
            printf 'HGET cluster/backup/%s %s\n' "$bid" name "$bid" enabled "$bid" instances "$bid" schedule_hint
        done | redis_batch)
    fi
    for i in "${!bids[@]}"; do
        bid="${bids[$i]}"
        backup_name["$bid"]="${values[$((i * 4))]:-}"
        enabled_text="${values[$((i * 4 + 1))]:-}"
        # list-backups treats any non-empty value as enabled.
        if [[ -n "$enabled_text" && "$enabled_text" != 0 ]]; then backup_enabled["$bid"]=1; else backup_enabled["$bid"]=0; fi
        backup_instances["$bid"]=" $(xargs <<< "${values[$((i * 4 + 2))]:-}") "
        hint="${values[$((i * 4 + 3))]:-}"
        backup_interval["$bid"]=$(grep -oP '"interval"\s*:\s*"\K[^"]+' <<< "$hint")
    done

    # Cluster-wide backup definitions are reported once, by the leader.
    if (( IS_LEADER )); then
        (( ${#bids[@]} == 0 )) && warning "No backup is configured in the cluster"
        for bid in "${bids[@]}"; do
            existing=0
            stale=""
            for mid in ${backup_instances[$bid]}; do
                if [[ -n "${CLUSTER_MODULE_NODE[$mid]+x}" ]]; then ((existing++)); else stale+="${stale:+ }${mid}"; fi
            done
            [[ -n "$stale" ]] && warning "Backup '${backup_name[$bid]}' (id ${bid}) references removed module(s): ${stale}"
            if (( backup_enabled[$bid] && existing == 0 )); then
                warning "Backup '${backup_name[$bid]}' (id ${bid}) is enabled but includes no installed module"
            fi
        done
    fi

    now=$(date +%s)
    # Fetch opt-out flags and all relevant statuses in two Redis round trips.
    mapfile -t mods < <(sed '/^$/d' <<< "$MODULES")
    (( ${#mods[@]} > 0 )) || return 0
    mapfile -t flags < <(printf 'SISMEMBER module/%s/flags no_data_backup\n' "${mods[@]}" | redis_batch)
    for mid in "${mods[@]}"; do
        for bid in "${bids[@]}"; do
            [[ "${backup_instances[$bid]}" == *" ${mid} "* ]] && requests+=("$bid $mid")
        done
    done
    if (( ${#requests[@]} > 0 )); then
        mapfile -t statuses < <(for request in "${requests[@]}"; do
            printf 'HGET node/%s/backup_status/%s %s\n' "$NODE_ID" "${request%% *}" "${request#* }"
        done | redis_batch)
        for i in "${!requests[@]}"; do
            status_of["${requests[$i]}"]="${statuses[$i]:-}"
        done
    fi
    for i in "${!mods[@]}"; do
        mid="${mods[$i]}"
        [[ "${flags[$i]:-0}" == 1 ]] && continue
        found=0
        disabled_names=""
        for bid in "${bids[@]}"; do
            [[ "${backup_instances[$bid]}" == *" ${mid} "* ]] || continue
            if (( ! backup_enabled[$bid] )); then
                disabled_names+="${disabled_names:+, }'${backup_name[$bid]}'"
                continue
            fi
            found=1
            label="${mid}: backup '${backup_name[$bid]}' (id ${bid})"
            status="${status_of["$bid $mid"]:-}"
            if [[ -z "$status" ]]; then
                warning "${label} has never completed on this node"
                continue
            fi
            errors=$(grep -oP '"errors"\s*:\s*\K[0-9]+' <<< "$status")
            end=$(grep -oP '"end"\s*:\s*\K[0-9]+' <<< "$status")
            if [[ "$errors" =~ ^[0-9]+$ ]] && (( errors > 0 )); then
                problem "${label}: last run failed with ${errors} error(s)"
            elif [[ ! "$end" =~ ^[0-9]+$ ]]; then
                info "${label}: last run has no end time (possibly running)"
            elif interval=$(backup_interval_seconds "${backup_interval[$bid]}") &&
                max_age=$(( 2 * interval + BACKUP_AGE_GRACE_SECONDS )) && (( now - end > max_age )); then
                warning "${label}: last run completed $(format_duration $(( now - end ))) ago (schedule: ${backup_interval[$bid]})"
            else
                ok "${label}: last run completed $(format_duration $(( now > end ? now - end : 0 ))) ago"
            fi
        done
        if (( ! found )); then
            warning "${mid}: not included in any enabled backup${disabled_names:+ (only in disabled ${disabled_names})}"
        fi
    done
    return 0
}

# Directories named like module IDs, with NS8 module state, whose module no
# longer exists in the cluster. Bases are /home plus parents of module homes,
# unless base directories are given as arguments.
# shellcheck disable=SC2120
check_orphan_module_homes() {
    local -a bases=("$@") orphans=()
    local -A seen=()
    local base dir name owner owner_uid size detail mod i found=0
    if (( ${#CLUSTER_MODULE_NODE[@]} == 0 )); then
        info "Cluster module inventory unavailable; leftover module home check skipped"
        return 0
    fi
    if (( ${#bases[@]} == 0 )); then
        [[ -d /home ]] && bases+=(/home)
        for mod in "${!MODULE_HOMES[@]}"; do
            bases+=("$(dirname -- "${MODULE_HOMES[$mod]}")")
        done
    fi
    for base in "${bases[@]}"; do
        [[ -n "${seen[$base]+x}" ]] && continue
        seen["$base"]=1
        for dir in "$base"/*; do
            [[ -d "$dir" && ! -L "$dir" ]] || continue
            name="${dir##*/}"
            [[ "$name" =~ ^[a-z][a-z0-9-]*[0-9]+$ ]] || continue
            [[ -n "${CLUSTER_MODULE_NODE[$name]+x}" ]] && continue
            [[ -d "$dir/.config/state" || -d "$dir/.local/share/containers" || -d "$dir/.config/systemd" ]] || continue
            orphans+=("$dir")
            # Sizes are computed in parallel; large homes may hit the timeout.
            start_query "du.${#orphans[@]}" timeout 20s du -sxh -- "$dir"
        done
    done
    for i in "${!orphans[@]}"; do
        dir="${orphans[$i]}"
        name="${dir##*/}"
        owner=$(stat -c %U -- "$dir" 2>/dev/null)
        owner_uid=$(stat -c %u -- "$dir" 2>/dev/null)
        if fetch_query "du.$((i + 1))"; then
            size=$(cut -f1 <<< "$QUERY_OUTPUT")
        else
            size=$(timeout 20s du -sxh -- "$dir" 2>/dev/null | cut -f1)
        fi
        detail="size ${size:-unknown}"
        if [[ "$owner" == UNKNOWN ]]; then
            detail+=", owner UID ${owner_uid} has no account"
        elif [[ -n "$owner" && "$owner" != "$name" ]]; then
            detail+=", owner UID ${owner_uid} now belongs to ${owner}"
        fi
        warning "Leftover home of removed module ${name}: ${dir} (${detail}); verify and remove it"
        found=1
    done
    (( found )) || ok "No leftover homes of removed modules found"
    return 0
}

check_software_repositories() {
    local key enabled=0 total=0 disabled="" i
    local -a names=() values=()
    while IFS= read -r key; do
        [[ "$key" == cluster/repository/* ]] && names+=("${key#cluster/repository/}")
    done < <(redis-cli --raw --scan --pattern 'cluster/repository/*' </dev/null 2>/dev/null)
    total=${#names[@]}
    if (( total > 0 )); then
        mapfile -t values < <(for key in "${names[@]}"; do
            printf 'HGET cluster/repository/%s status\nHGET cluster/repository/%s testing\n' "$key" "$key"
        done | redis_batch)
    fi
    for i in "${!names[@]}"; do
        if [[ "${values[$((i * 2))]:-}" == 1 ]]; then
            ((enabled++))
            [[ "${values[$((i * 2 + 1))]:-}" == 1 ]] && info "Software repository ${names[$i]} has testing releases enabled"
        else
            disabled+="${disabled:+, }${names[$i]}"
        fi
    done
    if (( total == 0 )); then
        warning "No software repository is configured: NS8 cannot offer module or core updates"
    elif (( enabled == 0 )); then
        warning "No software repository is enabled (disabled: ${disabled}): NS8 cannot offer module or core updates"
    else
        ok "${enabled} of ${total} software repositories enabled${disabled:+ (disabled: ${disabled})}"
    fi
}

# Updates as NS8 computes them (repositories, testing flags, min-core).
check_ns8_updates() {
    local core_image out lines id node version update testing found=0
    core_image=$(redis-cli --raw HGET "node/${NODE_ID}/environment" IMAGE_URL </dev/null 2>/dev/null)
    [[ -n "$core_image" ]] && info_always "NS8 core version on node ${NODE_ID}: ${core_image##*:}"
    if (( ! IS_LEADER )); then
        info "NS8 update availability is computed on the leader node; skipped on this worker"
        return 0
    fi
    if (( OFFLINE )); then
        info "NS8 update listing skipped (--offline)"
        return 0
    fi
    if ! command -v api-cli >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        info "api-cli or jq is not available; NS8 update listing skipped"
        return 0
    fi
    if out=$(timeout 120s api-cli run cluster/list-updates </dev/null 2>/dev/null) &&
        lines=$(jq -r '.[] | [.id, (.node // "" | tostring), (.version // ""), (.update // ""), (.testing_update // "")] | join("|")' <<< "$out" 2>/dev/null); then
        while IFS='|' read -r id node version update testing; do
            [[ -z "$id" ]] && continue
            if [[ -n "$update" ]]; then
                warning "${id} (node ${node}): NS8 update available ${version} -> ${update}"
                found=1
            elif [[ -n "$testing" ]]; then
                info "${id} (node ${node}): testing release ${testing} available"
            fi
        done <<< "$lines"
    else
        warning "Cannot list NS8 module updates (cluster/list-updates)"
    fi
    if out=$(timeout 120s api-cli run cluster/list-core-modules </dev/null 2>/dev/null) &&
        lines=$(jq -r '.[] | .instances[]? | select((.update // "") != "") | [.id, (.node // "" | tostring), (.version // ""), .update] | join("|")' <<< "$out" 2>/dev/null); then
        while IFS='|' read -r id node version update; do
            [[ -z "$id" ]] && continue
            warning "${id}${node:+ (node ${node})}: NS8 core update available ${version} -> ${update}"
            found=1
        done <<< "$lines"
    else
        warning "Cannot list NS8 core module updates (cluster/list-core-modules)"
    fi
    (( found )) || ok "No module or core updates offered by the enabled repositories"
}

check_subscription_status() {
    local out fields status expires expire_date expire_epoch now days
    [[ -n "$SUBSCRIPTION_SYSTEM_ID" ]] || return 0
    if (( ! IS_LEADER )); then
        info "Subscription status is checked on the leader node"
        return 0
    fi
    if (( OFFLINE )); then
        info "Subscription status check skipped (--offline)"
        return 0
    fi
    if ! command -v api-cli >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        info "api-cli or jq is not available; subscription status check skipped"
        return 0
    fi
    # The action queries the provider; read only status and expiry fields.
    if ! out=$(timeout 60s api-cli run cluster/get-subscription </dev/null 2>/dev/null) ||
        ! fields=$(jq -r '(.subscription // .) | [(.status // ""), ((.expires // false) | tostring), ((.expire_date // "") | tostring)] | join("|")' <<< "$out" 2>/dev/null); then
        warning "Cannot read subscription status (cluster/get-subscription)"
        return 0
    fi
    IFS='|' read -r status expires expire_date <<< "$fields"
    if [[ "$status" == active ]]; then
        ok "Subscription status is active"
    else
        warning "Subscription status is ${status:-unknown}"
    fi
    [[ "$expires" == true && -n "$expire_date" && "$expire_date" != -1 ]] || return 0
    if [[ "$expire_date" =~ ^[0-9]{13}$ ]]; then
        expire_epoch=$(( expire_date / 1000 ))
    elif [[ "$expire_date" =~ ^[0-9]+$ ]]; then
        expire_epoch="$expire_date"
    else
        expire_epoch=$(date -d "$expire_date" +%s 2>/dev/null)
    fi
    if [[ ! "$expire_epoch" =~ ^[0-9]+$ ]]; then
        info "Subscription expiry date ${expire_date} could not be parsed"
        return 0
    fi
    now=$(date +%s)
    days=$(( (expire_epoch - now) / 86400 ))
    if (( expire_epoch < now )); then
        problem "Subscription expired on ${expire_date}"
    elif (( days < SUBSCRIPTION_EXPIRY_WARNING_DAYS )); then
        warning "Subscription expires in ${days} day(s) (${expire_date})"
    else
        info "Subscription valid until ${expire_date}"
    fi
}

check_cluster_smarthost() {
    local enabled host
    { IFS= read -r enabled; IFS= read -r host; } < <(
        printf 'HGET cluster/smarthost enabled\nHGET cluster/smarthost host\n' | redis_batch)
    if [[ "$enabled" == 1 ]]; then
        ok "Cluster smarthost is enabled (${host:-host not set})"
    else
