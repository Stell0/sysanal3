BACKUP_AGE_GRACE_SECONDS=3600  # Slack added to twice the backup interval before a run is overdue
PODMAN_RECLAIMABLE_WARNING_BYTES=10000000000  # Warn when unused rootful images exceed 10 GB
SUBSCRIPTION_EXPIRY_WARNING_DAYS=30  # Warn when the subscription expires within this many days
INTERNET_OK=1                  # Set to 0 if connectivity precheck fails
