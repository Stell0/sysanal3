should_skip_whitelist_port_check() {
    local mod="$1" var_name="$2" unit=""

    PORT_CHECK_SKIP_REASON=""

    case "$var_name" in
        SATELLITE_HTTP_PORT|SATELLITE_RTP_PORT) unit=satellite.service ;;
        SATELLITE_MQTT_PORT) unit=satellite-mqtt.service ;;
        SATELLITE_PGSQL_PORT) unit=satellite-pgsql.service ;;
        *) return 1 ;;
    esac
    # Unit states were cached by check_module_services; no extra runagent call.
    if [[ "${MODULE_UNIT_ACTIVE["$mod|$unit"]:-}" != active ]]; then
        PORT_CHECK_SKIP_REASON="${unit} is not running"
        return 0
    fi
    return 1
}

check_configured_service_port() {
    local mod="$1" var_name="$2" port="$3" expected_regex="$4" expected_service="$5"
    local listeners processes

    listeners=$(get_listener_lines_by_port "$port")
    processes=$(get_listener_processes_by_port "$port")

    if [[ -z "$listeners" ]]; then
        problem "${mod}: ${var_name}=${port} is not used by any listening process"
        return 1
    fi

    if [[ -n "$expected_regex" ]] && ! echo " ${processes} " | grep -qiE "$expected_regex"; then
        problem "${mod}: ${var_name}=${port} is used by [${processes:-unknown}] instead of ${expected_service}"
        return 1
    fi

    ok "${mod}: ${var_name}=${port} is listening (processes: ${processes:-unknown})"
    return 0
}

audit_whitelist_ports_for_module() {
    local mod="$1" env_file
    local var_name port expected_regex expected_service

    resolve_module_paths "$mod" || return 0
    env_file="${MODULE_ENV_FILES[$mod]}"

    while read -r var_name; do
        [[ -z "$var_name" ]] && continue

        port=$(get_env_numeric_var "$env_file" "$var_name")
        [[ -z "$port" ]] && continue

        expected_service=$(get_whitelist_port_expected_service "$var_name") || continue
        expected_regex=$(get_whitelist_port_expected_regex "$var_name") || continue

        if should_skip_whitelist_port_check "$mod" "$var_name"; then
            info "${mod}: ${var_name}=${port} skipped (${PORT_CHECK_SKIP_REASON})"
            continue
        fi

        check_configured_service_port "$mod" "$var_name" "$port" "$expected_regex" "$expected_service"
    done <<< "$WHITELIST_PORT_VARIABLES"

    return 0
}

init_network_identity() {
    local raw_ips ip
    raw_ips=$(hostname -I 2>/dev/null | xargs || true)

    LOCAL_IPS_ARRAY=()
    if [[ -n "$raw_ips" ]]; then
        read -r -a LOCAL_IPS_ARRAY <<< "$raw_ips"
        LOCAL_IPS_DISPLAY="$raw_ips"
    fi

    PUBLIC_IP=""
    PUBLIC_IP_SOURCE=""
    if (( OFFLINE )) || ! command -v curl >/dev/null 2>&1; then
        return
    fi

    for ip_service in \
        "https://api64.ipify.org" \
        "https://ipv4.icanhazip.com" \
        "https://ifconfig.me/ip"
    do
        ip=$(curl -4 -fsS --max-time 5 "$ip_service" 2>/dev/null | tr -d '[:space:]' || true)
        if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
            PUBLIC_IP="$ip"
            PUBLIC_IP_SOURCE=lookup
            return
        fi
    done
}

is_local_ip() {
    local candidate="$1" ip
    [[ -z "$candidate" ]] && return 1
    for ip in "${LOCAL_IPS_ARRAY[@]}"; do
        [[ "$candidate" == "$ip" ]] && return 0
    done
    return 1
}

is_port_listening() {
