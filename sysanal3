    [[ -n "$(get_listener_lines_by_port "$port")" ]]
}

is_port_listening_by_process() {
    local port="$1" expected_regex="$2"
    local processes
    processes=$(get_listener_processes_by_port "$port")
    [[ -n "$processes" ]] && echo " ${processes} " | grep -qiE "$expected_regex"
}

probe_hairpin_sip() {
    local public_ip="$1"
    local port="$2"
    local protocol="$3"

    local local_ip branch tag call_id payload response contact_proto=""

    [[ "$public_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || {
        echo "invalid public IP: $public_ip" >&2
        return 2
    }

    # Both numeric format and range must pass.
    # shellcheck disable=SC2015
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || {
        echo "invalid port: $port" >&2
        return 2
    }

    local_ip="$(ip route get "$public_ip" 2>/dev/null | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "src") {
                    print $(i+1)
                    exit
                }
            }
        }'
    )"

    [[ -n "$local_ip" ]] || {
        echo "cannot determine local source IP for $public_ip" >&2
        return 2
    }

    branch="z9hG4bK-sysanal3-$$-$RANDOM"
    tag="sysanal3-$RANDOM"
    call_id="sysanal3-$RANDOM-$$@$local_ip"

    if [[ "$protocol" == "tcp" ]]; then
        contact_proto=";transport=tcp"
    elif [[ "$protocol" != "udp" ]]; then
        echo "invalid protocol: $protocol" >&2
        return 2
    fi

    payload=$(
        printf 'OPTIONS sip:sysanal3@%s:%s SIP/2.0\r\n' "$public_ip" "$port"
        printf 'Via: SIP/2.0/%s %s;rport;branch=%s\r\n' "$(printf '%s\n' "$protocol" | tr '[:lower:]' '[:upper:]')" "$local_ip" "$branch"
        printf 'Max-Forwards: 70\r\n'
        printf 'From: <sip:sysanal3@%s>;tag=%s\r\n' "$local_ip" "$tag"
        printf 'To: <sip:sysanal3@%s:%s>\r\n' "$public_ip" "$port"
        printf 'Call-ID: %s\r\n' "$call_id"
        printf 'CSeq: 1 OPTIONS\r\n'
        printf 'Contact: <sip:sysanal3@%s%s>\r\n' "$local_ip" "$contact_proto"
        printf 'Content-Length: 0\r\n'
    )

    printf '%s\n' "$payload" > /dev/null

    exec 3<>"/dev/$(printf '%s\n' "$protocol" | tr '[:upper:]' '[:lower:]')/$public_ip/$port" 2>/dev/null || return 3

    printf '%s' "$payload" >&3 || {
        exec 3>&-
        exec 3<&-
        return 1
    }

    # Read one UDP datagram, not a "line"
    # Consume a datagram; its contents are intentionally not reported.
    # shellcheck disable=SC2034
    if ! response="$(timeout 4 dd bs=65535 count=1 status=none <&3 2>/dev/null)"; then
        exec 3>&-
        exec 3<&-
        return 1
    fi
 
    exec 3>&-
    exec 3<&-
}

probe_hairpin_udp_by_local_listener() {
    local public_ip="$1"
    local port="$2"

    [[ "$public_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 2
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || return 2

    if ! command -v python3 >/dev/null 2>&1; then
        return 2
    fi

    timeout 8 python3 - "$public_ip" "$port" <<'PY' >/dev/null 2>&1
import os
import random
import socket
import sys
import time

public_ip = sys.argv[1]
port = int(sys.argv[2])
deadline = time.time() + 6
payload = f"sysanal3-hairpin-{port}-{os.getpid()}-{random.randint(0, 999999)}".encode()

listener = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
if hasattr(socket, "SO_REUSEPORT"):
    try:
        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    except OSError:
        pass

try:
    listener.bind(("", port))
except OSError:
    sys.exit(3)

listener.settimeout(max(0.1, deadline - time.time()))

sender = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    sender.sendto(payload, (public_ip, port))
except OSError:
    sys.exit(3)

while time.time() < deadline:
    try:
        data, _addr = listener.recvfrom(65535)
    except socket.timeout:
        break
    if payload in data:
        sys.exit(0)
    listener.settimeout(max(0.1, deadline - time.time()))

sys.exit(1)
PY
}

probe_hairpin_tcp_tls() {
    local public_ip="$1" port="$2"

    if ! command -v openssl >/dev/null 2>&1; then
        return 2
    fi

    timeout 6 openssl s_client -connect "${public_ip}:${port}" -brief </dev/null >/dev/null 2>&1
}

probe_tls_certificate() {
    local hostname="$1" port="$2"
    local openssl_out cert_file

    if ! command -v openssl >/dev/null 2>&1; then
        TLS_CERT_ERROR="openssl is not available"
        return 2
    fi

    if [[ -z "$hostname" || -z "$port" ]]; then
        TLS_CERT_ERROR="hostname or port is empty"
        return 7
    fi

    cert_file=$(mktemp)
    if [[ -z "$cert_file" || ! -f "$cert_file" ]]; then
        TLS_CERT_ERROR="could not create temporary file"
        return 7
    fi

    if ! openssl_out=$(timeout 8 openssl s_client -connect "${hostname}:${port}" -servername "$hostname" -showcerts </dev/null 2>&1); then
        rm -f "$cert_file"
        TLS_CERT_ERROR=$(echo "$openssl_out" | awk 'NF { line=$0 } END { print line }')
        TLS_CERT_ERROR=${TLS_CERT_ERROR:-connection failed}
        return 3
    fi

    if ! echo "$openssl_out" | awk '
        /-----BEGIN CERTIFICATE-----/ {
            capture = 1
        }
        capture {
            print
        }
        /-----END CERTIFICATE-----/ {
            exit
        }
    ' > "$cert_file"; then
        rm -f "$cert_file"
        TLS_CERT_ERROR="could not extract peer certificate"
        return 4
    fi

    if [[ ! -s "$cert_file" ]]; then
        rm -f "$cert_file"
        TLS_CERT_ERROR="peer did not provide a certificate"
        return 4
    fi

    if ! openssl x509 -in "$cert_file" -noout >/dev/null 2>&1; then
        rm -f "$cert_file"
        TLS_CERT_ERROR="peer certificate is not valid X.509 data"
        return 4
    fi

    if ! openssl x509 -in "$cert_file" -noout -checkhost "$hostname" >/dev/null 2>&1; then
        rm -f "$cert_file"
        TLS_CERT_ERROR="certificate does not match hostname ${hostname}"
        return 5
    fi

    if ! openssl x509 -in "$cert_file" -noout -checkend 0 >/dev/null 2>&1; then
        rm -f "$cert_file"
        TLS_CERT_ERROR="certificate is expired"
        return 6
    fi

    rm -f "$cert_file"
    TLS_CERT_ERROR=""
    return 0
}

check_tls_certificate_endpoint() {
    local label="$1" hostname="$2" port="$3"

    if (( OFFLINE )); then
        info "${label}: certificate check skipped for ${hostname}:${port} (--offline)"
        return 0
    fi

    if probe_tls_certificate "$hostname" "$port"; then
        ok "${label}: certificate is valid for ${hostname}:${port}"
        return 0
    fi

    case $? in
        2)
            info "${label}: certificate check skipped for ${hostname}:${port}: ${TLS_CERT_ERROR}"
            ;;
        3|4|5|6)
            problem "${label}: certificate check failed for ${hostname}:${port}: ${TLS_CERT_ERROR}"
            ;;
        *)
            warning "${label}: certificate check skipped for ${hostname}:${port}: ${TLS_CERT_ERROR}"
            ;;
    esac

    return 1
}

# First UDP port in [min+1, max] without a local listener; the probe binds it.
pick_free_udp_port() {
    local min="$1" max="$2" port limit
    local -A used=()
    while read -r port; do
        [[ "$port" =~ ^[0-9]+$ ]] && used["$port"]=1
    done < <(ss -H -lun 2>/dev/null | awk '{n=split($4, a, ":"); print a[n]}')
    limit=$(( max < min + 200 ? max : min + 200 ))
    for (( port = min + 1; port <= limit; port++ )); do
        [[ -z "${used[$port]+x}" ]] && { printf '%s\n' "$port"; return 0; }
    done
    return 1
}

# RTP range of the first local nethvoice-proxy, as "min max".
get_proxy_rtp_range() {
    local proxy_mod env_file min max
    while read -r proxy_mod; do
        [[ -z "$proxy_mod" ]] && continue
        resolve_module_paths "$proxy_mod" || continue
        env_file="${MODULE_ENV_FILES[$proxy_mod]}"
        min=$(get_env_numeric_var "$env_file" RTP_PORT_MIN)
        max=$(get_env_numeric_var "$env_file" RTP_PORT_MAX)
        if [[ -n "$min" && -n "$max" ]] && (( min < max && max <= 65535 )); then
            printf '%s %s\n' "$min" "$max"
            return 0
        fi
    done <<< "$(get_modules_by_name nethvoice-proxy)"
    return 1
}

check_hairpin_nat_for_nethvoice() {
    local nv_mod="$1"
    local sip_port=5060 tls_port=5061 rtp_port="" rtp_min rtp_max configured processes port
    local expected_regex='(^| )kamailio( |$)'

    if (( OFFLINE )); then
        info "${nv_mod}: hairpin NAT checks skipped (--offline)"
        return
    fi
    if [[ -z "$PUBLIC_IP" ]]; then
        info "${nv_mod}: hairpin NAT checks skipped: public IP not available"
        return
    fi
    if is_local_ip "$PUBLIC_IP"; then
        info "${nv_mod}: hairpin NAT checks skipped: public IP matches a local machine address (${PUBLIC_IP})"
        return
    fi

    # Kamailio signaling uses the instance PROXY_PORT; SIP/TLS is fixed at 5061.
    if resolve_module_paths "$nv_mod"; then
        configured=$(get_env_numeric_var "${MODULE_ENV_FILES[$nv_mod]}" PROXY_PORT)
        [[ -n "$configured" ]] && sip_port="$configured"
    fi
    if read -r rtp_min rtp_max < <(get_proxy_rtp_range); then
        rtp_port=$(pick_free_udp_port "$rtp_min" "$rtp_max") || rtp_port=""
    else
        rtp_port=10001
    fi

    for port in "$sip_port" "$tls_port"; do
        if ! is_port_listening "$port"; then
            info "${nv_mod}: hairpin NAT check skipped for port ${port}: port is not listening"
            continue
        fi
        if ! is_port_listening_by_process "$port" "$expected_regex"; then
            processes=$(get_listener_processes_by_port "$port")
            info "${nv_mod}: hairpin NAT check skipped for port ${port}: port is owned by [${processes:-unknown}] instead of kamailio"
            continue
        fi
        if [[ "$port" == "$sip_port" ]]; then
            if probe_hairpin_sip "$PUBLIC_IP" "$port" "udp"; then
                ok "${nv_mod}: hairpin NAT works for SIP/UDP port ${port} via ${PUBLIC_IP}"
            else
                case $? in
                    2) info "${nv_mod}: hairpin NAT check skipped for SIP/UDP port ${port}: /dev/udp is not available" ;;
                    *) problem "${nv_mod}: hairpin NAT failed for SIP/UDP port ${port} via ${PUBLIC_IP}" ;;
                esac
            fi
            if probe_hairpin_sip "$PUBLIC_IP" "$port" "tcp"; then
                ok "${nv_mod}: hairpin NAT works for SIP/TCP port ${port} via ${PUBLIC_IP}"
            else
                case $? in
                    2) info "${nv_mod}: hairpin NAT check skipped for SIP/TCP port ${port}: /dev/tcp is not available" ;;
                    *) problem "${nv_mod}: hairpin NAT failed for SIP/TCP port ${port} via ${PUBLIC_IP}" ;;
                esac
            fi
        else
            if probe_hairpin_tcp_tls "$PUBLIC_IP" "$port"; then
                ok "${nv_mod}: hairpin NAT works for SIP/TLS port ${port} via ${PUBLIC_IP}"
            else
                case $? in
                    2) info "${nv_mod}: hairpin NAT check skipped for SIP/TLS port ${port}: openssl is not available" ;;
                    *) problem "${nv_mod}: hairpin NAT failed for SIP/TLS port ${port} via ${PUBLIC_IP}" ;;
                esac
            fi
        fi
    done

    if [[ -z "$rtp_port" ]]; then
        info "${nv_mod}: hairpin NAT check skipped for RTP: no free UDP port in the proxy RTP range"
        return
    fi
    if probe_hairpin_udp_by_local_listener "$PUBLIC_IP" "$rtp_port"; then
        ok "${nv_mod}: hairpin NAT works for RTP UDP port ${rtp_port} via ${PUBLIC_IP}"
    else
        case $? in
            2) info "${nv_mod}: hairpin NAT check skipped for UDP port ${rtp_port}: Python 3 is not available" ;;
            3) problem "${nv_mod}: hairpin NAT check for UDP port ${rtp_port} could not start a local listener on port ${rtp_port}" ;;
            *) problem "${nv_mod}: hairpin NAT failed for RTP UDP port ${rtp_port} via ${PUBLIC_IP}" ;;
        esac
    fi
}

get_env_numeric_var() {
    local env_file="$1" var_name="$2"
    grep -oP "^${var_name}=\K[0-9]+$" "$env_file" 2>/dev/null | head -1
}

get_env_var() {
    local env_file="$1" var_name="$2"
    grep -oP "^${var_name}=\K.*" "$env_file" 2>/dev/null | head -1
}

collect_nethvoice_proxy_domain_uris() {
    local proxy_modules proxy_mod proxy_out proxy_rc domain uri existing_uri existing_source

    NETHVOICE_PROXY_DOMAIN_URI_MAP=()
    NETHVOICE_PROXY_DOMAIN_SOURCE_MAP=()
    NETHVOICE_PROXY_MODULE_COUNT=0
    NETHVOICE_PROXY_ROUTE_COUNT=0

    proxy_modules=$(echo "$MODULES_ON_NODE" | awk -F'|' '$4 == "nethvoice-proxy" {print $1}' || true)
    if [[ -z "$proxy_modules" ]]; then
        info "No nethvoice-proxy modules found on this node"
        return
    fi

    while read -r proxy_mod; do
        [[ -z "$proxy_mod" ]] && continue
        ((NETHVOICE_PROXY_MODULE_COUNT++))

        proxy_out=$(runagent -m "$proxy_mod" podman exec -i postgres sh -lc "
psql -U \"\$POSTGRES_USER\" \"\$POSTGRES_DB\" <<'SQL'
COPY (
  SELECT r.target AS domain, d.destination AS uri
  FROM nethvoice_proxy_routes r
  JOIN dispatcher d ON d.setid = r.setid
  WHERE r.route_type = 'domain'
  ORDER BY r.target, d.destination
) TO STDOUT WITH CSV HEADER;
SQL
" 2>&1)
        proxy_rc=$?

        if [[ "$proxy_rc" -ne 0 ]]; then
            warning "${proxy_mod}: could not retrieve domain routes from postgres"
            while read -r line; do
                [[ -n "$line" ]] && echo "  ${line}"
            done <<< "$proxy_out"
            continue
        fi

        while IFS=',' read -r domain uri; do
            domain=$(echo "$domain" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
            uri=$(echo "$uri" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

            [[ -z "$domain" || "$domain" == "domain" ]] && continue
            [[ -z "$uri" ]] && continue

            if [[ -n "${NETHVOICE_PROXY_DOMAIN_URI_MAP[$domain]+x}" ]]; then
                existing_uri="${NETHVOICE_PROXY_DOMAIN_URI_MAP[$domain]}"
                existing_source="${NETHVOICE_PROXY_DOMAIN_SOURCE_MAP[$domain]}"
                if [[ "$existing_uri" != "$uri" ]]; then
                    problem "${proxy_mod}: conflicting proxy URI for domain ${domain} (existing: ${existing_uri} from ${existing_source}, found: ${uri})"
                    continue
                fi
                continue
            fi

            NETHVOICE_PROXY_DOMAIN_URI_MAP["$domain"]="$uri"
            NETHVOICE_PROXY_DOMAIN_SOURCE_MAP["$domain"]="$proxy_mod"
            ((NETHVOICE_PROXY_ROUTE_COUNT++))
        done <<< "$proxy_out"
    done <<< "$proxy_modules"

    if [[ "$NETHVOICE_PROXY_ROUTE_COUNT" -gt 0 ]]; then
        info "Collected ${NETHVOICE_PROXY_ROUTE_COUNT} NethVoice domain route(s) from ${NETHVOICE_PROXY_MODULE_COUNT} nethvoice-proxy module(s)"
    elif [[ "$NETHVOICE_PROXY_MODULE_COUNT" -gt 0 ]]; then
        warning "No NethVoice domain routes found in local nethvoice-proxy modules"
    fi
}

check_nethvoice_proxy_domain_uri() {
    local nv_mod="$1" nv_env_file
    local nethvoice_host expected_sip_port expected_uri actual_uri proxy_source proxy_ip route_host

    resolve_module_paths "$nv_mod" || return 0
    nv_env_file="${MODULE_ENV_FILES[$nv_mod]}"

    nethvoice_host=$(get_env_var "$nv_env_file" "NETHVOICE_HOST")
    if [[ -z "$nethvoice_host" ]]; then
        warning "${nv_mod}: NETHVOICE_HOST is not set; proxy domain URI validation skipped"
        return
    fi

    # Newer versions route proxy signaling to a separately allocated UDP port.
    expected_sip_port=$(get_env_numeric_var "$nv_env_file" "ASTERISK_SIP_UDP_PORT")
    if [[ -z "$(get_env_var "$nv_env_file" "ASTERISK_SIP_UDP_PORT")" ]]; then
        expected_sip_port=$(get_env_numeric_var "$nv_env_file" "ASTERISK_SIP_PORT")
    fi
    if [[ -z "$expected_sip_port" ]]; then
        warning "${nv_mod}: proxy SIP port (ASTERISK_SIP_UDP_PORT or ASTERISK_SIP_PORT) is missing or invalid; proxy domain URI validation skipped"
        return
    fi

    proxy_ip=$(get_env_var "$nv_env_file" "PROXY_IP")
    if [[ -z "$proxy_ip" ]]; then
        proxy_ip="$LOCAL_VPN_ADDRESS"
        info "${nv_mod}: PROXY_IP is unavailable; using the local wg0 address for route validation"
    fi
    if [[ -z "$proxy_ip" ]]; then
        warning "${nv_mod}: cannot determine proxy address; proxy domain URI validation skipped"
        return
    fi
    if ! is_local_ip "$proxy_ip" && [[ "$proxy_ip" != "$LOCAL_VPN_ADDRESS" ]]; then
        problem "${nv_mod}: configured PROXY_IP does not belong to this node; proxy domain URI validation skipped"
        return
    fi
    route_host="$proxy_ip"
    [[ "$route_host" == *:* ]] && route_host="[${route_host}]"

    if [[ "$NETHVOICE_PROXY_ROUTE_COUNT" -eq 0 ]]; then
        info "${nv_mod}: proxy domain URI validation skipped: no nethvoice-proxy routes available"
        return
    fi

    if [[ -z "${NETHVOICE_PROXY_DOMAIN_URI_MAP[$nethvoice_host]+x}" ]]; then
        problem "${nv_mod}: no nethvoice-proxy route found for NETHVOICE_HOST=${nethvoice_host}"
        return
    fi

    expected_uri="sip:${route_host}:${expected_sip_port}"
    actual_uri="${NETHVOICE_PROXY_DOMAIN_URI_MAP[$nethvoice_host]}"
    proxy_source="${NETHVOICE_PROXY_DOMAIN_SOURCE_MAP[$nethvoice_host]}"

    if [[ "$actual_uri" == "$expected_uri" ]]; then
        ok "${nv_mod}: nethvoice-proxy route for ${nethvoice_host} matches ${expected_uri}${proxy_source:+ (source: ${proxy_source})}"
    else
        problem "${nv_mod}: nethvoice-proxy route for ${nethvoice_host} must be ${expected_uri}, found ${actual_uri}${proxy_source:+ (source: ${proxy_source})}"
    fi
}

