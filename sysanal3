problem() { echo -e "${RED}[PROBLEM]${NC} $*"; PROBLEM_MSGS+=("$*"); ((PROBLEMS++)); }
warning() { echo -e "${YELLOW}[WARNING]${NC} $*"; WARNING_MSGS+=("$*"); ((WARNINGS++)); }
info()    { [[ ${SILENT:-0} -eq 1 ]] || echo -e "${CYAN}[INFO]${NC} $*"; }
info_always() { echo -e "${CYAN}[INFO]${NC} $*"; }
ok()      { [[ ${SILENT:-0} -eq 1 ]] || echo -e "${GREEN}[OK]${NC} $*"; }
header()  { echo ""; echo -e "${BOLD}=== $* ===${NC}"; }

# Results are updated by direct calls in the parent shell, never by $(...).
# Keep attempted paths on failure for diagnostics, but consumers require status 0.
declare -A MODULE_PATH_STATUS=()
declare -A MODULE_ENV_FILES=()
declare -A MODULE_HOMES=()

is_absolute_single_path() {
    [[ "$1" == /* && ! "$1" =~ [[:cntrl:]] ]]
}

resolve_module_paths() {
    local mod="$1" state_dir passwd_entry account_name module_home=""
    local runtime_reason lookup_rc env_file failure_reason

    if [[ -n "${MODULE_PATH_STATUS[$mod]+cached}" ]]; then
        return "${MODULE_PATH_STATUS[$mod]}"
    fi
    MODULE_PATH_STATUS["$mod"]=1

    query_module_context "$mod"
    if [[ "${MODULE_CONTEXT_STATUS[$mod]}" == 0 ]]; then
        state_dir="${MODULE_STATE_DIR_OUTPUT[$mod]}"
        state_dir="${state_dir%$'\n'}"
        if is_absolute_single_path "$state_dir"; then
            runtime_reason=""
        else
            runtime_reason="AGENT_STATE_DIR is empty or not a single absolute directory path"
        fi
    else
        runtime_reason="AGENT_STATE_DIR lookup failed or timed out"
    fi

    # Also discover rootless homes for filesystem reporting. An account is not
    # required when NS8 provides a valid state directory (rootful modules).
    if passwd_entry=$(getent passwd "$mod" </dev/null 2>/dev/null
        lookup_rc=$?; printf '.'; exit "$lookup_rc"); then
        passwd_entry="${passwd_entry%.}"
        passwd_entry="${passwd_entry%$'\n'}"
        if [[ ! "$passwd_entry" =~ [[:cntrl:]] && "$passwd_entry" =~ ^([^:]*:){6}[^:]*$ ]]; then
            IFS=: read -r account_name _ _ _ _ module_home _ <<< "$passwd_entry"
            if [[ "$account_name" == "$mod" ]] && is_absolute_single_path "$module_home"; then
                MODULE_HOMES["$mod"]="$module_home"
            fi
        fi
    fi

    if [[ -z "$runtime_reason" ]]; then
        env_file="${state_dir%/}/environment"
    elif [[ -n "${MODULE_HOMES[$mod]:-}" ]]; then
        env_file="${MODULE_HOMES[$mod]%/}/.config/state/environment"
    else
        warning "${mod}: ${runtime_reason}; no valid NSS account home; environment-dependent checks skipped (check runagent and getent passwd ${mod})"
        return 1
    fi

    MODULE_ENV_FILES["$mod"]="$env_file"
    if [[ ! -e "$env_file" ]]; then
        failure_reason="environment file is missing"
    elif [[ ! -f "$env_file" ]]; then
        failure_reason="environment path is not a regular file"
    elif [[ ! -r "$env_file" ]]; then
        failure_reason="environment file is unreadable"
    else
        MODULE_PATH_STATUS["$mod"]=0
        return 0
    fi

    warning "${mod}: ${failure_reason} (${env_file}); environment-dependent checks skipped (check path and permissions)"
    return 1
}

resolve_local_module_paths() {
    local mod
    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        resolve_module_paths "$mod" || true
    done <<< "$MODULES"
}

report_module_home_filesystems() {
    local mod module_home target root_target usage reported=0
    local -A reported_targets=([/]=1)
    root_target=$(findmnt -n -o TARGET --target / 2>/dev/null) || root_target="/"
    [[ -n "$root_target" ]] && reported_targets["$root_target"]=1

    while IFS= read -r mod; do
        [[ -z "$mod" ]] && continue
        module_home="${MODULE_HOMES[$mod]:-}"
        [[ -z "$module_home" ]] && continue
        target=$(findmnt -n -o TARGET --target "$module_home" 2>/dev/null) || continue
        [[ -z "$target" || -n "${reported_targets[$target]+reported}" ]] && continue
        reported_targets["$target"]=1
        ((reported++))
        usage=$(df -h -- "$module_home" 2>/dev/null | awk 'NR==2{printf "%s used / %s total (%s full)", $3, $2, $5}')
        info_always "${target} filesystem (module homes): ${usage:-N/A}"
        check_filesystem_usage "${target} filesystem" "$module_home"
    done <<< "$MODULES"
    if (( reported == 0 )); then
        info "All module homes are on the root filesystem"
    fi
    return 0
}

