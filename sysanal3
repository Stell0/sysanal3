    fi
}

# ---------------------------------------------------------------------------
# NethVoice and proxy checks
# ---------------------------------------------------------------------------
check_nethvoice_dns() {
    local nv_mod="$1" dns_start dns_out dns_end dns_ms line
    dns_start=$(date +%s%N)
    dns_out=$(runagent -m "$nv_mod" podman exec freepbx getent hosts ibm.com </dev/null 2>&1 || true)
    dns_end=$(date +%s%N)
    dns_ms=$(( (dns_end - dns_start) / 1000000 ))

    if [[ -z "$dns_out" || "$dns_ms" -gt $DNS_SLOW_MS ]]; then
        problem "${nv_mod}: DNS resolution failed or too slow (${dns_ms}ms, getent hosts ibm.com)"
        info "${nv_mod}: /etc/resolv.conf inside container freepbx:"
        runagent -m "$nv_mod" podman exec freepbx cat /etc/resolv.conf </dev/null 2>/dev/null | while read -r line; do
            echo "  ${line}"
        done
    else
        ok "${nv_mod}: DNS OK (ibm.com resolved in ${dns_ms}ms)"
    fi
}

check_nethvoice_call_forwards() {
    local nv_mod="$1" cf_out cf_mappings cf_ext cf_dest cf_target start_ext current_ext next_ext
    local cycle_start_index cycle_ext cycle_desc
    local -a cf_path=() cycle_exts=()
    local -A cf_targets=() reported_cf_cycles=() visited_cf=()

    if ! cf_out=$(freepbx_section "$nv_mod" cf); then
        info "${nv_mod}: could not retrieve AstDB CF entries"
        return 0
    fi
    # Parse AstDB output lines like:
    #   /CF/200                                       : 210
    # and keep a unique extension|destination mapping for later checks.
    cf_mappings=$(echo "$cf_out" | awk '
        /^[[:space:]]*\/CF\// {
            line = $0
            sub(/^[[:space:]]*\/CF\//, "", line)
            split(line, parts, /[[:space:]]*:[[:space:]]*/)
            ext = parts[1]
            dest = parts[2]
            sub(/[[:space:]].*$/, "", ext)
            sub(/^[[:space:]]+/, "", dest)
            sub(/[[:space:]]+$/, "", dest)
            if (ext != "") {
                print ext "|" dest
            }
        }
    ' | sort -u)

    if [[ -z "$cf_mappings" ]]; then
        ok "${nv_mod}: no extensions with call forward enabled (AstDB CF)"
        return 0
    fi

    while IFS='|' read -r cf_ext cf_dest; do
        [[ -z "$cf_ext" ]] && continue
        # Keep only a numeric extension target so we can walk CF chains.
        # If the destination is external or non-numeric, the extension still
        # gets a warning but it is not considered for circular-chain checks.
        cf_target=""
        if [[ "$cf_dest" =~ ^[0-9]+$ ]]; then
            cf_target="$cf_dest"
        elif [[ "$cf_dest" =~ (^|[^0-9])([0-9]{2,})([^0-9]|$) ]]; then
            cf_target="${BASH_REMATCH[2]}"
        fi
        cf_targets["$cf_ext"]="$cf_target"
        warning "${nv_mod}: Extension ${cf_ext} has call forward enabled"
    done <<< "$cf_mappings"

    # Follow each extension CF chain until it ends or loops back to a
    # previously visited extension. A repeated node means a circular CF.
    for start_ext in "${!cf_targets[@]}"; do
        visited_cf=()
        cf_path=()
        current_ext="$start_ext"
        while [[ -n "$current_ext" && -n "${cf_targets[$current_ext]+x}" ]]; do
            if [[ -n "${visited_cf[$current_ext]+x}" ]]; then
                cycle_start_index=${visited_cf[$current_ext]}
                cycle_exts=( "${cf_path[@]:$cycle_start_index}" )
                cycle_desc=""
                for cycle_ext in "${cycle_exts[@]}"; do
                    [[ -n "$cycle_desc" ]] && cycle_desc+=" -> "
                    cycle_desc+="$cycle_ext"
                done
                cycle_desc+=" -> ${current_ext}"
                for cycle_ext in "${cycle_exts[@]}"; do
                    if [[ -z "${reported_cf_cycles[$cycle_ext]+x}" ]]; then
                        problem "${nv_mod}: Extension ${cycle_ext} has circular call forward configuration (${cycle_desc})"
                        reported_cf_cycles["$cycle_ext"]=1
                    fi
                done
                break
            fi
            visited_cf["$current_ext"]=${#cf_path[@]}
            cf_path+=("$current_ext")
            next_ext="${cf_targets[$current_ext]}"
            [[ -z "$next_ext" ]] && break
            current_ext="$next_ext"
        done
    done
    return 0
}

check_nethvoice_queue_strategy() {
    local nv_mod="$1" queue_out ringall_queue_agents ringall_queue_count queue_name queue_agents
    local max_ringall_agents=0 max_ringall_queue="" ringall_over_limit=""

    if ! queue_out=$(freepbx_section "$nv_mod" queues) || [[ -z "$queue_out" ]]; then
        info "${nv_mod}: could not retrieve queue strategy data (Asterisk queue show unavailable)"
        return 0
    fi
    # Parse `queue show` output queue-by-queue and count members only for
    # queues whose strategy is explicitly set to `ringall`.
    ringall_queue_agents=$(echo "$queue_out" | awk -v sq="'" '
        BEGIN { queue = ""; is_ringall = 0; in_members = 0; agents = 0 }
        function flush_queue() {
            if (is_ringall && queue != "") {
                print queue "|" agents
            }
        }
        /^[^[:space:]].* has .* strategy/ {
            flush_queue()
            queue = ""
            is_ringall = 0
            in_members = 0
            agents = 0
            if (match($0, /^(.+) has .* in /, m)) {
                queue = m[1]
            }
            if (index($0, " in " sq "ringall" sq " strategy") > 0) {
                is_ringall = 1
            }
            next
        }
        is_ringall && /^[[:space:]]+Members:[[:space:]]*$/ { in_members = 1; next }
        is_ringall && /^[[:space:]]+Callers:[[:space:]]*$/ { in_members = 0; next }
        is_ringall && in_members {
            if ($0 ~ /^[[:space:]]+[^[:space:]]+/ && $0 !~ /^[[:space:]]+No Members/) {
                agents++
            }
            next
        }
        END { flush_queue() }
    ')

    ringall_queue_count=$(echo "$ringall_queue_agents" | sed '/^$/d' | wc -l)
    if [[ -n "$ringall_queue_agents" ]]; then
        # Evaluate both warning conditions:
        # 1. too many queues using ringall
        # 2. any ringall queue with too many agents
        while IFS='|' read -r queue_name queue_agents; do
            [[ -z "$queue_name" ]] && continue
            [[ -z "$queue_agents" || ! "$queue_agents" =~ ^[0-9]+$ ]] && queue_agents=0
            if (( queue_agents > max_ringall_agents )); then
                max_ringall_agents=$queue_agents
                max_ringall_queue=$queue_name
            fi
            if (( queue_agents > QUEUE_RINGALL_MAX_AGENTS )); then
                ringall_over_limit+="${queue_name}(${queue_agents}) "
            fi
        done <<< "$ringall_queue_agents"
    fi

    if (( ringall_queue_count > QUEUE_RINGALL_MAX_QUEUES )) || [[ -n "$ringall_over_limit" ]]; then
        warning "${nv_mod}: Asterisk ringall strategy may overload endpoints (ringall queues: ${ringall_queue_count}, threshold: ${QUEUE_RINGALL_MAX_QUEUES}; queues with >${QUEUE_RINGALL_MAX_AGENTS} agents: ${ringall_over_limit:-none})"
    elif (( ringall_queue_count > 0 )); then
        info "${nv_mod}: ringall queues: ${ringall_queue_count} (max agents in a ringall queue: ${max_ringall_agents}${max_ringall_queue:+ in ${max_ringall_queue}})"
    else
        ok "${nv_mod}: no queues using ringall strategy"
    fi
}

# kamcmd dispatcher.list: each destination has "URI:" then "FLAGS:"; the
# first flag is A(ctive), I(nactive), D(isabled), T(rying) or P(robing).
evaluate_dispatcher_destinations() {
    local proxy_mod="$1" output="$2" line uri="" flags count=0
    while IFS= read -r line; do
        line="${line#"${line%%[![:space:]]*}"}"
        case "$line" in
            URI:*)
                uri="${line#URI:}"
                uri="${uri#"${uri%%[![:space:]]*}"}"
                ;;
            FLAGS:*)
                flags="${line#FLAGS:}"
                flags="${flags//[[:space:]]/}"
                ((count++))
                case "${flags:0:1}" in
                    A) ok "${proxy_mod}: dispatcher destination ${uri} is active (${flags})" ;;
                    I) problem "${proxy_mod}: dispatcher destination ${uri} is inactive (${flags}): the proxy cannot reach this NethVoice instance" ;;
                    D) problem "${proxy_mod}: dispatcher destination ${uri} is disabled (${flags})" ;;
                    *) warning "${proxy_mod}: dispatcher destination ${uri} state is ${flags:-unknown} (probing)" ;;
                esac
                ;;
        esac
    done <<< "$output"
    (( count )) || warning "${proxy_mod}: Kamailio dispatcher has no destinations"
    return 0
}

check_nethvoice_proxy_runtime() {
    local proxy_mod="$1" output total proxy_public
    collect_proxy_snapshot "$proxy_mod"
    if output=$(snapshot_section "proxy:$proxy_mod" dispatcher); then
        evaluate_dispatcher_destinations "$proxy_mod" "$output"
    else
        warning "${proxy_mod}: cannot read Kamailio dispatcher destinations"
    fi
    if output=$(snapshot_section "proxy:$proxy_mod" rtpengine); then
        total=$(sed -nE 's/^Current sessions total: *([0-9]+).*/\1/p' <<< "$output")
        ok "${proxy_mod}: RTPengine answers (${total:-unknown} active session(s))"
    else
        problem "${proxy_mod}: RTPengine control interface does not answer (media relay may be down)"
    fi
    # A stale PUBLIC_IP is advertised in SDP and causes one-way or no audio.
    if [[ "$PUBLIC_IP_SOURCE" == lookup ]] && resolve_module_paths "$proxy_mod"; then
        proxy_public=$(get_env_var "${MODULE_ENV_FILES[$proxy_mod]}" PUBLIC_IP)
        if [[ -n "$proxy_public" && "$proxy_public" != "$PUBLIC_IP" ]]; then
            warning "${proxy_mod}: configured PUBLIC_IP ${proxy_public} differs from the detected public IP ${PUBLIC_IP} (risk of one-way or missing audio)"
        elif [[ -n "$proxy_public" ]]; then
            ok "${proxy_mod}: configured PUBLIC_IP matches the detected public IP"
        fi
    fi
}

