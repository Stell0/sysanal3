        info "Modules on node ${NODE_ID}:"
        while IFS='|' read -r mod_id mod_source mod_version mod_name; do
            info "  - ${mod_id} (${mod_name}) version ${mod_version}"
        done <<< "$MODULES_ON_NODE"
    fi

    # Resolve every local module once (in parallel), then start the runtime
    # queries; they complete while the cluster checks run.
    prefetch_module_contexts
    resolve_local_module_paths
    prefetch_module_runtime
    header "General System Data: Module home filesystems"
    report_module_home_filesystems

    # Without lookups, fall back to the address configured in the proxy.
