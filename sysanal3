# Background queries: slow read-only commands (runagent start-up costs seconds
# on loaded nodes) run in parallel and are consumed later by name. Without a
# work directory, or for names never started, consumers run inline.
BG_DIR=""
MAX_PARALLEL_QUERIES=8
declare -A BG_PIDS=()
QUERY_OUTPUT=""
QUERY_RC=""

start_query() {
    local name="$1"
    shift
    [[ -n "$BG_DIR" ]] || return 1
    while (( $(jobs -rp | wc -l) >= MAX_PARALLEL_QUERIES )); do
        wait -n 2>/dev/null || break
    done
    ( "$@" > "$BG_DIR/$name" 2>/dev/null </dev/null; echo $? > "$BG_DIR/$name.rc" ) </dev/null &
    BG_PIDS["$name"]=$!
}

# Wait for a started query; sets QUERY_OUTPUT (exact bytes) and QUERY_RC.
fetch_query() {
    local name="$1"
    [[ -n "$BG_DIR" ]] || return 1
    if [[ -n "${BG_PIDS[$name]:-}" ]]; then
        wait "${BG_PIDS[$name]}" 2>/dev/null
        unset 'BG_PIDS[$name]'
    fi
    [[ -f "$BG_DIR/$name.rc" ]] || return 1
    QUERY_OUTPUT=$(cat -- "$BG_DIR/$name"; printf '.')
    QUERY_OUTPUT="${QUERY_OUTPUT%.}"
    QUERY_RC=$(cat -- "$BG_DIR/$name.rc")
    return 0
}

# Single-line-reply Redis commands, one per stdin line, in one redis-cli
# process: on NS8 redis-cli itself starts through runagent. Prints one line
# per command (empty for nil).
redis_batch() {
    redis-cli --raw 2>/dev/null
}

# Discover the module execution UID, rather than assuming every module is rootless.
declare -A MODULE_RUNTIME_UIDS=()
declare -A MODULE_RUNTIME_STATUS=()
declare -A MODULE_CONTEXT_STATUS=()
declare -A MODULE_STATE_DIR_OUTPUT=()
# Active state of module units, keyed by "<module>|<unit>", for later checks.
declare -A MODULE_UNIT_ACTIVE=()

# One runagent call yields the execution UID and AGENT_STATE_DIR: runagent
# start-up costs seconds on loaded nodes. Status 3 means only the UID is known.
module_context_command() {
    # shellcheck disable=SC2016
    timeout "${RUNAGENT_TIMEOUT}s" runagent -m "$1" sh -c 'id -u || exit 1; printenv AGENT_STATE_DIR || exit 3' </dev/null 2>/dev/null
}

query_module_context() {
    local mod="$1" output rc uid
    [[ -n "${MODULE_CONTEXT_STATUS[$mod]+cached}" ]] && return 0
    if fetch_query "context.$mod"; then
        output="$QUERY_OUTPUT"
        rc="$QUERY_RC"
    else
        # A sentinel preserves trailing newlines so extra blank lines are rejected.
        output=$(module_context_command "$mod"; rc=$?; printf '.'; exit "$rc")
        rc=$?
        output="${output%.}"
    fi
    uid="${output%%$'\n'*}"
    if [[ ( "$rc" == 0 || "$rc" == 3 ) && "$output" == *$'\n'* && "$uid" =~ ^[0-9]+$ ]]; then
        MODULE_RUNTIME_UIDS["$mod"]="$uid"
    fi
    if [[ "$rc" == 0 ]]; then
        MODULE_CONTEXT_STATUS["$mod"]=0
        MODULE_STATE_DIR_OUTPUT["$mod"]="${output#*$'\n'}"
    else
        MODULE_CONTEXT_STATUS["$mod"]="$rc"
    fi
    return 0
}

resolve_module_runtime() {
    local mod="$1"
    if [[ -n "${MODULE_RUNTIME_STATUS[$mod]+cached}" ]]; then
        return "${MODULE_RUNTIME_STATUS[$mod]}"
    fi
    query_module_context "$mod"
    if [[ -n "${MODULE_RUNTIME_UIDS[$mod]:-}" ]]; then
        MODULE_RUNTIME_STATUS["$mod"]=0
        return 0
    fi
    MODULE_RUNTIME_STATUS["$mod"]=1
    warning "${mod}: cannot determine module execution UID; container and service checks skipped"
    return 1
}

module_services_command() {
    local mod="$1"
    local -a manager_args=() unit_args=()
    if [[ "${MODULE_RUNTIME_UIDS[$mod]}" == 0 ]]; then
        # Only module-owned system units; do not inspect the whole host per module.
        unit_args=("${mod}.service" "${mod}-*.service")
    else
        manager_args=(--user)
    fi
    timeout "${RUNAGENT_TIMEOUT}s" runagent -m "$mod" systemctl "${manager_args[@]}" show \
        --all --type=service --no-pager \
        --property=Id,Type,LoadState,ActiveState,SubState,UnitFileState,Result,NRestarts,TriggeredBy,ConditionResult,ActiveEnterTimestampMonotonic \
        "${unit_args[@]}" </dev/null 2>/dev/null
}

check_module_services() {
    local mod="$1" service_output line key value now_usec rc
    local -A properties=()
    resolve_module_runtime "$mod" || return 0
    if fetch_query "services.$mod"; then
        service_output="$QUERY_OUTPUT"
        rc="$QUERY_RC"
    else
        service_output=$(module_services_command "$mod")
        rc=$?
    fi
    if [[ "$rc" != 0 ]]; then
        warning "${mod}: cannot query module services"
        return 0
    fi
    now_usec=$(monotonic_now_usec)
    # systemctl show returns property blocks separated by blank lines.
    while IFS= read -r line; do
        if [[ -z "$line" ]]; then
            report_module_service_state "$mod" properties "$now_usec"
            properties=()
        elif [[ "$line" == *=* ]]; then
            key="${line%%=*}"; value="${line#*=}"
            case "$key" in
                Id|Type|LoadState|ActiveState|SubState|UnitFileState|Result|NRestarts|TriggeredBy|ConditionResult|ActiveEnterTimestampMonotonic)
                    # Read through the nameref in report_module_service_state.
                    # shellcheck disable=SC2034
                    properties["$key"]="$value" ;;
            esac
        fi
    done <<< "$service_output"$'\n'
    return 0
}

# CLOCK_MONOTONIC in microseconds, comparable with systemd *Monotonic stamps.
monotonic_now_usec() {
    awk '{ printf "%d\n", $1 * 1000000 }' /proc/uptime 2>/dev/null
}

format_duration() {
    local seconds="$1"
    if (( seconds >= 86400 )); then
        printf '%dd %dh' $((seconds / 86400)) $((seconds % 86400 / 3600))
    elif (( seconds >= 3600 )); then
        printf '%dh %dm' $((seconds / 3600)) $((seconds % 3600 / 60))
    elif (( seconds >= 60 )); then
        printf '%dm' $((seconds / 60))
    else
        printf '%ds' "$seconds"
    fi
}

report_module_service_state() {
    local mod="$1" now_usec="${3:-}"
    local -n service_props="$2"
    local unit="${service_props[Id]:-}" restarts="${service_props[NRestarts]:-}"
    local started="${service_props[ActiveEnterTimestampMonotonic]:-}" age=""
    [[ -z "$unit" || "${service_props[LoadState]:-}" != loaded ]] && return 0
    MODULE_UNIT_ACTIVE["$mod|$unit"]="${service_props[ActiveState]:-}"
    if [[ "${service_props[ActiveState]:-}" == failed ]]; then
        problem "${mod}: service ${unit} is failed"
    elif [[ "${service_props[ActiveState]:-}" == inactive &&
        "${service_props[Type]:-}" != oneshot &&
        "${service_props[ConditionResult]:-}" != no &&
        -z "${service_props[TriggeredBy]:-}" &&
        "${service_props[UnitFileState]:-}" =~ ^enabled(-runtime)?$ ]]; then
        warning "${mod}: enabled service ${unit} is inactive"
    fi
    if [[ "${service_props[ActiveState]:-}" != failed ]]; then
        case "${service_props[Result]:-}" in
            exit-code|signal|core-dump|timeout|watchdog|start-limit-hit|resources|protocol|oom-kill)
                warning "${mod}: service ${unit} last run ended with ${service_props[Result]}" ;;
        esac
    fi
    # Seconds since the unit last became active; restarts reset this stamp.
    if [[ "$started" =~ ^[1-9][0-9]*$ && "$now_usec" =~ ^[0-9]+$ ]] && (( now_usec >= started )); then
        age=$(( (now_usec - started) / 1000000 ))
    fi
    if [[ "${service_props[SubState]:-}" == auto-restart ]]; then
        if [[ "$restarts" =~ ^[0-9]+$ ]] && (( restarts > RESTART_THRESHOLD )); then
            problem "${mod}: service ${unit} is repeatedly restarting (${restarts} automatic restarts)"
        else
            warning "${mod}: service ${unit} is waiting for automatic restart"
        fi
    elif [[ "$restarts" =~ ^[0-9]+$ ]] && (( restarts > RESTART_THRESHOLD )); then
        if [[ -n "$age" ]] && (( age > RESTART_RECENT_SECONDS )); then
            # Old bursts, e.g. agents waiting for Redis during a core update.
            info "${mod}: service ${unit} has ${restarts} historical automatic restarts; stable for $(format_duration "$age")"
        else
            warning "${mod}: service ${unit} has ${restarts} automatic restarts since counter reset${age:+, last start $(format_duration "$age") ago}; check recent logs (threshold: ${RESTART_THRESHOLD})"
        fi
    fi
    return 0
}

# Runs in the module context: list containers, then inspect selected fields
# of module-owned ones. Rootful Podman is shared with the host, so NS8-owned
# containers are selected by the module ID or its hyphen-prefixed names.
CONTAINER_QUERY_SCRIPT=$(cat <<'EOF'
inventory=$(podman ps -a --format '{{.ID}}|{{.Names}}') || exit 1
printf '%s\n' "$inventory"
ids=$(printf '%s\n' "$inventory" | while IFS='|' read -r id name; do
    [ -n "$id" ] || continue
    if [ "$3" = 1 ]; then
        case "$name" in "$2"|"$2"-*) ;; *) continue ;; esac
    fi
    printf '%s\n' "$id"
done)
[ -n "$ids" ] || exit 0
printf '@@inspect\n'
podman inspect --format "$1" -- $ids || exit 2
EOF
)

module_containers_command() {
    local mod="$1" rootful=0
    local format='{{.Name}}|{{.State.Status}}|{{.RestartCount}}|{{.State.OOMKilled}}|{{if .State.Healthcheck}}{{.State.Healthcheck.Status}}{{end}}'
    [[ "${MODULE_RUNTIME_UIDS[$mod]}" == 0 ]] && rootful=1
    # Inspect selected fields only: full inspect output contains environment secrets.
    timeout "${RUNAGENT_TIMEOUT}s" runagent -m "$mod" sh -c "$CONTAINER_QUERY_SCRIPT" sh "$format" "$mod" "$rootful" </dev/null 2>/dev/null
}

check_module_containers() {
    local mod="$1" output rc id name state restarts oom health extra line
    local inventory="" inspect="" in_inspect=0
    resolve_module_runtime "$mod" || return 0
    if fetch_query "containers.$mod"; then
        output="$QUERY_OUTPUT"
        rc="$QUERY_RC"
    else
        output=$(module_containers_command "$mod")
        rc=$?
    fi
    while IFS= read -r line; do
        if [[ "$line" == '@@inspect' ]]; then
            in_inspect=1
        elif (( in_inspect )); then
            inspect+="$line"$'\n'
        else
            inventory+="$line"$'\n'
        fi
    done <<< "$output"
    if [[ "$rc" != 0 ]] && (( ! in_inspect )); then
        warning "${mod}: cannot list module containers"
        return 0
    fi
    while IFS='|' read -r id name extra; do
        [[ -z "$id$name$extra" ]] && continue
        [[ "$id" =~ ^[a-f0-9]{12,64}$ && "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && -z "$extra" ]] || {
            warning "${mod}: invalid container inventory; container checks skipped"
            return 0
        }
    done <<< "$inventory"
    (( in_inspect )) || return 0
    if [[ "$rc" != 0 ]]; then
        warning "${mod}: cannot inspect module container health"
        return 0
    fi
    while IFS='|' read -r name state restarts oom health extra; do
        [[ -z "$name$state$restarts$oom$health$extra" ]] && continue
        name="${name#/}"
        if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ || ! "$restarts" =~ ^[0-9]+$ ||
            ! "$oom" =~ ^(true|false)$ || -n "$extra" ||
            ! "$state" =~ ^(configured|created|initialized|running|stopped|exited|paused|restarting|removing|dead|unknown)$ ||
            ! "$health" =~ ^(healthy|unhealthy|starting)?$ ]]; then
            warning "${mod}: invalid container health data"
            continue
        fi
        info "${mod}: container ${name} (state: ${state}, restarts: ${restarts}, health: ${health:-not configured})"
        case "$state" in
            created|exited|stopped|paused) warning "${mod}: container ${name} is ${state}" ;;
            dead) problem "${mod}: container ${name} is dead" ;;
        esac
        if (( restarts > RESTART_THRESHOLD )); then
            problem "${mod}: container ${name} has ${restarts} restarts (threshold: ${RESTART_THRESHOLD})"
        fi
        [[ "$oom" == true ]] && problem "${mod}: container ${name} was killed due to memory exhaustion (OOM)"
        [[ "$health" == unhealthy ]] && problem "${mod}: container ${name} is unhealthy"
    done <<< "$inspect"
    return 0
}

check_node_memory() {
    local meminfo_file="${1:-/proc/meminfo}" memory_total memory_available swap_total swap_free
    local used_pct swap_used
    read -r memory_total memory_available swap_total swap_free < <(awk '
        /^MemTotal:/ {total=$2; have_total=1} /^MemAvailable:/ {available=$2; have_available=1}
        /^SwapTotal:/ {swap_total=$2} /^SwapFree:/ {swap_free=$2}
        END {
            if (!have_total || !have_available) print "unknown unknown 0 0"
            else print total, available, swap_total+0, swap_free+0
        }
    ' "$meminfo_file" 2>/dev/null)
    if [[ ! "$memory_total" =~ ^[0-9]+$ || "$memory_total" == 0 ||
        ! "$memory_available" =~ ^[0-9]+$ ]] || (( memory_available > memory_total )); then
        warning "Cannot determine available node memory"
        return 0
    fi
    used_pct=$(( (memory_total - memory_available) * 100 / memory_total ))
    info_always "Memory: ${memory_available} KiB available / ${memory_total} KiB total (${used_pct}% used, accounting for reclaimable cache)"
    if (( used_pct >= MEMORY_PROBLEM_PCT )); then
        problem "Node memory usage at ${used_pct}% (>= ${MEMORY_PROBLEM_PCT}%)"
    elif (( used_pct >= MEMORY_WARNING_PCT )); then
        warning "Node memory usage at ${used_pct}% (>= ${MEMORY_WARNING_PCT}%)"
    fi
    if [[ "$swap_total" =~ ^[0-9]+$ && "$swap_free" =~ ^[0-9]+$ ]] && (( swap_free <= swap_total )); then
        swap_used=$(( swap_total - swap_free ))
        info_always "Swap: ${swap_used} KiB used / ${swap_total} KiB total"
    fi
    return 0
}

# Container snapshots run many read-only commands in one runagent/podman exec.
# Each section starts with "<marker> <name> <exit-status>"; the random marker
# cannot be forged by command output we did not expect.
SNAPSHOT_PRELUDE=$(cat <<'EOF'
marker=$1
shift
section() {
    name=$1
    shift
    out=$("$@" 2>/dev/null)
    rc=$?
    printf '%s %s %s\n' "$marker" "$name" "$rc"
    [ -z "$out" ] || printf '%s\n' "$out"
}
section_with_errors() {
    name=$1
    shift
    out=$("$@" 2>&1)
    rc=$?
    printf '%s %s %s\n' "$marker" "$name" "$rc"
    [ -z "$out" ] || printf '%s\n' "$out"
}
EOF
)

# Contacts, endpoints, registrations and channels are reduced to counts inside
# the container so URIs, caller IDs and device identities are never collected.
FREEPBX_SNAPSHOT_SCRIPT=$(cat <<'EOF'
channel_max_age=$1
rx() { asterisk -rx "$1"; }
contacts() {
    out=$(asterisk -rx 'pjsip show contacts') || return 1
    printf '%s\n' "$out" | sed -nE 's/^Objects found: *([0-9]+) *$/\1/p'
}
endpoints() {
    out=$(asterisk -rx 'pjsip show endpoints') || return 1
    printf '%s\n' "$out" | awk '/^ *Endpoint: / && !/</ { total++; if ($0 ~ /Unavailable/) unavailable++ }
        END { print total+0, unavailable+0 }'
}
registrations() {
    out=$(asterisk -rx 'pjsip show registrations') || return 1
    printf '%s\n' "$out" | awk '
        /^Objects found: *[0-9]+/ { total = $3 }
        !/</ && /[[:space:]](Rejected|Unregistered|Stopped)([[:space:]]|$)/ { failed++ }
        END { print total+0, failed+0 }'
}
long_channels() {
    out=$(asterisk -rx 'core show channels concise') || return 1
    printf '%s\n' "$out" | awk -F'!' -v max="$channel_max_age" '
        NF >= 12 { total++; if ($12 + 0 > max) long++ }
        END { print total+0, long+0 }'
}
cidname() {
    out=$(asterisk -rx 'database show AMPUSER') || return 1
    printf '%s\n' "$out" | sed -nE 's/^[[:space:]]*(\/AMPUSER\/\/cidname[[:space:]]*:.*)$/\1/p'
}
smtp_from() { if [ -n "${SMTP_FROM_ADDRESS:-}" ]; then echo 1; else echo 0; fi; }
mailcmd_from() {
    if grep -E '^[[:space:]]*mailcmd[[:space:]]*=' /etc/asterisk/voicemail.conf 2>/dev/null | grep -qF -- 'send_email -f '; then
        echo 1
    else
        echo 0
    fi
}
section version rx 'core show version'
section uptime rx 'core show uptime seconds'
section channels rx 'core show channels count'
section contacts contacts
section endpoints endpoints
section registrations registrations
section long_channels long_channels
section cidname cidname
section cf rx 'database show CF'
section queues rx 'queue show'
section transports rx 'pjsip show transports'
section smtp_from smtp_from
section mailcmd_from mailcmd_from
EOF
)

